{
  "id": "meadow-breeze-5",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 434,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट लें, या यदि बेहतर लगे तो लेट जाएँ।",
      "file": "c001.ogg",
      "durationSec": 9.432
    },
    {
      "index": 2,
      "text": "अपने हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.824
    },
    {
      "index": 3,
      "text": "अपनी आँखों को बंद होने दें, या अपनी निगाहें नरम कर लें।",
      "file": "c003.ogg",
      "durationSec": 8.928
    },
    {
      "index": 4,
      "text": "अपने शरीर के भार पर ध्यान दें।",
      "file": "c004.ogg",
      "durationSec": 5.616
    },
    {
      "index": 5,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c005.ogg",
      "durationSec": 6.048
    },
    {
      "index": 6,
      "text": "और लंबी, आसान साँस छोड़ना।",
      "file": "c006.ogg",
      "durationSec": 6.264
    },
    {
      "index": 7,
      "text": "दोबारा। नरम श्वास.",
      "file": "c007.ogg",
      "durationSec": 6.744
    },
    {
      "index": 8,
      "text": "धीरे से साँस छोड़ें.",
      "file": "c008.ogg",
      "durationSec": 4.728
    },
    {
      "index": 9,
      "text": "यदि विचार भटकते हैं तो यह ठीक है। श्वास पर लौटें।",
      "file": "c009.ogg",
      "durationSec": 11.016
    },
    {
      "index": 10,
      "text": "देर सुबह एक विस्तृत पहाड़ी घास के मैदान की कल्पना करें।",
      "file": "c010.ogg",
      "durationSec": 9.12
    },
    {
      "index": 11,
      "text": "लंबी घासें आसान लहरों में लहराती हैं।",
      "file": "c011.ogg",
      "durationSec": 6.696
    },
    {
      "index": 12,
      "text": "सूरज तेज़ न होते हुए भी गर्म है।",
      "file": "c012.ogg",
      "durationSec": 6.168
    },
    {
      "index": 13,
      "text": "इसे अपने सिर के शीर्ष पर महसूस करें, दयालु और स्थिर।",
      "file": "c013.ogg",
      "durationSec": 9.432
    },
    {
      "index": 14,
      "text": "एक ताज़ी हवा घास से होकर गुजरती है और आपका चेहरा ढूंढती है।",
      "file": "c014.ogg",
      "durationSec": 10.032
    },
    {
      "index": 15,
      "text": "इसमें जंगली फूलों और धूप में सूखी धरती की खुशबू आती है।",
      "file": "c015.ogg",
      "durationSec": 9.408
    },
    {
      "index": 16,
      "text": "आप धीरे-धीरे चलते हैं, उंगलियों से बीज के सिरों को ब्रश करते हैं।",
      "file": "c016.ogg",
      "durationSec": 9.6
    },
    {
      "index": 17,
      "text": "कोमल गुदगुदी. मुलायम ध्वनि।",
      "file": "c017.ogg",
      "durationSec": 7.104
    },
    {
      "index": 18,
      "text": "तितलियाँ बिना किसी हड़बड़ी के फिर से उठती हैं और बैठ जाती हैं।",
      "file": "c018.ogg",
      "durationSec": 9.864
    },
    {
      "index": 19,
      "text": "आपको घास में लेटने के लिए जगह मिल जाती है।",
      "file": "c019.ogg",
      "durationSec": 6.84
    },
    {
      "index": 20,
      "text": "पृथ्वी तुम्हारी सारी लम्बाई को धारण करती है।",
      "file": "c020.ogg",
      "durationSec": 7.248
    },
    {
      "index": 21,
      "text": "आपके सामने गर्मजोशी। आपके किनारों पर ठंडी मिट्टी-छाया।",
      "file": "c021.ogg",
      "durationSec": 10.8
    },
    {
      "index": 22,
      "text": "हवा दोस्ताना ज्वार की तरह आती और चली जाती है।",
      "file": "c022.ogg",
      "durationSec": 8.016
    },
    {
      "index": 23,
      "text": "ताजगी का श्वास लें। खुले आसमान में सांस छोड़ें।",
      "file": "c023.ogg",
      "durationSec": 9.864
    },
    {
      "index": 24,
      "text": "एक बादल एक क्षण के लिए सूर्य पर सरक जाता है।",
      "file": "c024.ogg",
      "durationSec": 7.392
    },
    {
      "index": 25,
      "text": "शीतलता. फिर आपके चेहरे पर गर्माहट लौट आती है।",
      "file": "c025.ogg",
      "durationSec": 9.72
    },
    {
      "index": 26,
      "text": "ध्यान दें कि शांति कितनी बड़ी लगती है।",
      "file": "c026.ogg",
      "durationSec": 6.816
    },
    {
      "index": 27,
      "text": "इस विस्तृत क्षेत्र में कोई भी चिंता कितनी छोटी लगती है.",
      "file": "c027.ogg",
      "durationSec": 8.4
    },
    {
      "index": 28,
      "text": "आपके हाथ घास में आराम कर रहे हैं। छोटे-छोटे तने प्यार से दबाएँ।",
      "file": "c028.ogg",
      "durationSec": 11.736
    },
    {
      "index": 29,
      "text": "अपनी बंद आंखों पर सूरज की गर्माहट बरकरार रखें।",
      "file": "c029.ogg",
      "durationSec": 8.184
    },
    {
      "index": 30,
      "text": "अपनी भुजाओं पर घास के नरम दबाव के साथ रहें।",
      "file": "c030.ogg",
      "durationSec": 7.56
    },
    {
      "index": 31,
      "text": "आपको अभी भी ऐसा ही रहने की अनुमति है।",
      "file": "c031.ogg",
      "durationSec": 6.864
    },
    {
      "index": 32,
      "text": "कुछ और चक्रों के लिए घास के मैदान को आपको सांस लेने दें।",
      "file": "c032.ogg",
      "durationSec": 9.216
    },
    {
      "index": 33,
      "text": "अपना ध्यान सिर के गर्म मुकुट से हटाएँ",
      "file": "c033.ogg",
      "durationSec": 6.432
    },
    {
      "index": 34,
      "text": "कोमल चेहरे, कोमल गले से होकर,",
      "file": "c034.ogg",
      "durationSec": 6.24
    },
    {
      "index": 35,
      "text": "एक ऐसे संदूक में जो खुले आसमान के नीचे आसानी से उठ जाता है।",
      "file": "c035.ogg",
      "durationSec": 10.68
    },
    {
      "index": 36,
      "text": "हवा आपकी कलाइयों के अंदर का पता लगा लेती है।",
      "file": "c036.ogg",
      "durationSec": 7.416
    },
    {
      "index": 37,
      "text": "ठंडा। जीवित। दोस्ताना।",
      "file": "c037.ogg",
      "durationSec": 9.192
    },
    {
      "index": 38,
      "text": "कहीं-कहीं मधुमक्खियाँ बिना किसी तात्कालिकता के काम करती हैं।",
      "file": "c038.ogg",
      "durationSec": 8.712
    },
    {
      "index": 39,
      "text": "उनकी गुनगुनाहट एक अन्य प्रकार की शांति है।",
      "file": "c039.ogg",
      "durationSec": 7.008
    },
    {
      "index": 40,
      "text": "तब तक बने रहें जब तक गर्माहट और ताजगी एक कपड़े की तरह महसूस न हो जाए।",
      "file": "c040.ogg",
      "durationSec": 11.784
    },
    {
      "index": 41,
      "text": "अब थोड़ी देर के लिए अकेले सांसों पर आराम करें।",
      "file": "c041.ogg",
      "durationSec": 8.112
    },
    {
      "index": 42,
      "text": "धीरे-धीरे श्वास लें।",
      "file": "c042.ogg",
      "durationSec": 4.416
    },
    {
      "index": 43,
      "text": "धीरे-धीरे सांस छोड़ें।",
      "file": "c043.ogg",
      "durationSec": 4.896
    },
    {
      "index": 44,
      "text": "श्वास लें.",
      "file": "c044.ogg",
      "durationSec": 3.168
    },
    {
      "index": 45,
      "text": "साँस छोड़ें।",
      "file": "c045.ogg",
      "durationSec": 3.672
    },
    {
      "index": 46,
      "text": "जहां भी शरीर गर्म हो वहां गर्माहट महसूस करें।",
      "file": "c046.ogg",
      "durationSec": 7.8
    },
    {
      "index": 47,
      "text": "जहां भी हवा ठंडी हो वहां ठंडक महसूस करें।",
      "file": "c047.ogg",
      "durationSec": 7.944
    },
    {
      "index": 48,
      "text": "श्वास लें.",
      "file": "c048.ogg",
      "durationSec": 3.168
    },
    {
      "index": 49,
      "text": "साँस छोड़ें।",
      "file": "c049.ogg",
      "durationSec": 3.672
    },
    {
      "index": 50,
      "text": "कहीं भी नहीं जाना। ठीक करने के लिए कुछ भी नहीं.",
      "file": "c050.ogg",
      "durationSec": 9.0
    },
    {
      "index": 51,
      "text": "श्वास लें.",
      "file": "c051.ogg",
      "durationSec": 3.168
    },
    {
      "index": 52,
      "text": "साँस छोड़ें।",
      "file": "c052.ogg",
      "durationSec": 3.672
    },
    {
      "index": 53,
      "text": "कुछ शांत सांसों के लिए यहां आराम करें।",
      "file": "c053.ogg",
      "durationSec": 6.672
    },
    {
      "index": 54,
      "text": "जान लें कि आप इस जगह पर कभी भी लौट सकते हैं।",
      "file": "c054.ogg",
      "durationSec": 8.544
    },
    {
      "index": 55,
      "text": "जब आप तैयार हों तो सांस को गहरा करें।",
      "file": "c055.ogg",
      "durationSec": 6.984
    },
    {
      "index": 56,
      "text": "उँगलियाँ और पैर की उँगलियाँ हिलाएँ।",
      "file": "c056.ogg",
      "durationSec": 6.024
    },
    {
      "index": 57,
      "text": "अपनी आँखें धीरे से खोलें.",
      "file": "c057.ogg",
      "durationSec": 5.76
    },
    {
      "index": 58,
      "text": "इस शांति का थोड़ा हिस्सा अपने साथ रखें।",
      "file": "c058.ogg",
      "durationSec": 7.128
    }
  ]
}
