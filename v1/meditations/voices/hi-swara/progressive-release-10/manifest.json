    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "यह अभ्यास हल्के तनाव और मुक्ति का उपयोग करता है।",
      "file": "c001.ogg",
      "durationSec": 7.968
    },
    {
      "index": 2,
      "text": "यदि आप कर सकते हैं तो लेट जाएं, या सहारा लेकर बैठें।",
      "file": "c002.ogg",
      "durationSec": 9.816
    },
    {
      "index": 3,
      "text": "अगर सुरक्षित महसूस हो तो आंखें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 7.272
    },
    {
      "index": 4,
      "text": "जबरदस्ती करने जैसी कोई बात नहीं. आरामदायक दायरे में रहें.",
      "file": "c004.ogg",
      "durationSec": 11.256
    },
    {
      "index": 5,
      "text": "धीरे-धीरे सांस अंदर लें.",
      "file": "c005.ogg",
      "durationSec": 5.16
    },
    {
      "index": 6,
      "text": "और एक लंबी सांस छोड़ें.",
