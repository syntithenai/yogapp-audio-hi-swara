{
  "id": "coastal-walk-10",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 775,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "ऐसा आसन खोजें जो आपसे कुछ न पूछे।",
      "file": "c001.ogg",
      "durationSec": 7.608
    },
    {
      "index": 2,
      "text": "आपको जिस भी सहारे की आवश्यकता हो, उसके साथ बैठें या लेटें।",
      "file": "c002.ogg",
      "durationSec": 10.464
    },
    {
      "index": 3,
      "text": "अपने हाथों को खुला या मुलायम रहने दें।",
      "file": "c003.ogg",
      "durationSec": 6.336
    },
    {
      "index": 4,
      "text": "अपनी आँखों को बंद होने दें, या नरम नज़र रखें।",
      "file": "c004.ogg",
      "durationSec": 8.16
    },
    {
      "index": 5,
      "text": "उन स्थानों को महसूस करें जहां आपका शरीर जमीन से मिलता है।",
      "file": "c005.ogg",
      "durationSec": 9.648
    },
    {
      "index": 6,
      "text": "एड़ियाँ, बैठने की हड्डियाँ, सिर का पिछला भाग, या रीढ़ की हड्डी की लंबाई।",
      "file": "c006.ogg",
      "durationSec": 12.168
    },
    {
      "index": 7,
      "text": "अभी रुकने के लिए कुछ भी नहीं है.",
      "file": "c007.ogg",
      "durationSec": 5.544
    },
    {
      "index": 8,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c008.ogg",
      "durationSec": 6.048
    },
    {
      "index": 9,
      "text": "आती हुई हवा की ठंडक को महसूस करें।",
      "file": "c009.ogg",
      "durationSec": 6.792
    },
    {
      "index": 10,
      "text": "और थोड़ी देर सांस छोड़ें.",
      "file": "c010.ogg",
      "durationSec": 5.208
    },
    {
      "index": 11,
      "text": "बाहर निकलती सांस की गर्माहट को महसूस करें।",
      "file": "c011.ogg",
      "durationSec": 7.776
    },
    {
      "index": 12,
      "text": "दोबारा। नरम श्वास.",
      "file": "c012.ogg",
      "durationSec": 6.744
    },
    {
      "index": 13,
      "text": "बिना जल्दबाजी के साँस छोड़ें।",
      "file": "c013.ogg",
      "durationSec": 5.808
    },
    {
      "index": 14,
      "text": "कंधों को थोड़ा सा गिरने दें।",
      "file": "c014.ogg",
      "durationSec": 5.184
    },
    {
      "index": 15,
      "text": "जबड़े को खुला रहने दो.",
      "file": "c015.ogg",
      "durationSec": 4.848
    },
    {
      "index": 16,
      "text": "पेट को नरम रहने दें.",
      "file": "c016.ogg",
      "durationSec": 4.656
    },
    {
      "index": 17,
      "text": "तीन शांत सांसों के साथ वैसे ही रहें जैसे वे हैं।",
      "file": "c017.ogg",
      "durationSec": 7.776
    },
    {
      "index": 18,
      "text": "श्वास लें. आना।",
      "file": "c018.ogg",
      "durationSec": 5.736
    },
    {
      "index": 19,
      "text": "साँस छोड़ें। निपटारा करना।",
      "file": "c019.ogg",
      "durationSec": 7.056
    },
    {
      "index": 20,
      "text": "यदि मन भटकता है, तो कृपया उस पर ध्यान दें, और इस सांस पर वापस आएँ।",
      "file": "c020.ogg",
      "durationSec": 12.12
    },
    {
      "index": 21,
      "text": "निचली चट्टानों के किनारे एक तटीय पथ देखें।",
      "file": "c021.ogg",
      "durationSec": 7.68
    },
    {
      "index": 22,
      "text": "समुद्र नीचे लम्बी, स्थिर लहरों में सांस लेता है।",
      "file": "c022.ogg",
      "durationSec": 8.52
    },
    {
      "index": 23,
      "text": "सूरज की रोशनी आपके सिर के ऊपरी हिस्से और आपकी नाक के पुल को गर्म करती है।",
      "file": "c023.ogg",
      "durationSec": 11.544
    },
    {
      "index": 24,
      "text": "नमकीन हवा आपकी पलकों को चमकदार ताजगी से ठंडा कर देती है।",
      "file": "c024.ogg",
      "durationSec": 9.912
    },
    {
      "index": 25,
      "text": "समुद्र की गंध महसूस करें - खनिज, स्वच्छ, जाग्रत।",
      "file": "c025.ogg",
      "durationSec": 10.248
    },
    {
      "index": 26,
      "text": "तुम धीरे-धीरे चलो. घासें हवा में अंदर की ओर झुक जाती हैं।",
      "file": "c026.ogg",
      "durationSec": 10.872
    },
    {
      "index": 27,
      "text": "एक गाल पर धूप और दूसरे पर ठंडी हवा महसूस करें।",
      "file": "c027.ogg",
      "durationSec": 8.568
    },
    {
      "index": 28,
      "text": "वह विरोधाभास अपने आप में एक प्रकार की शांति है।",
      "file": "c028.ogg",
      "durationSec": 7.8
    },
    {
      "index": 29,
      "text": "एक लकड़ी की सीढ़ी एक छिपे हुए समुद्र तट की ओर जाती है।",
      "file": "c029.ogg",
      "durationSec": 8.952
    },
    {
      "index": 30,
      "text": "हर कदम निश्चित है. आपका हाथ एक पुरानी रेलिंग पर टिका हुआ है।",
      "file": "c030.ogg",
      "durationSec": 10.848
    },
    {
      "index": 31,
      "text": "अपनी हथेली के नीचे गर्म लकड़ी.",
      "file": "c031.ogg",
      "durationSec": 6.024
    },
    {
      "index": 32,
      "text": "तल पर, रेत आपके पैरों को नरम हाँ की तरह स्वीकार करती है।",
      "file": "c032.ogg",
      "durationSec": 9.12
    },
    {
      "index": 33,
      "text": "उस ओर चलें जहां लहरें सफेद रेखाएं लिखती और मिटाती हैं।",
      "file": "c033.ogg",
      "durationSec": 10.056
    },
    {
      "index": 34,
      "text": "ठंडा पानी आपकी एड़ियों पर जमा हो जाता है।",
      "file": "c034.ogg",
      "durationSec": 6.96
    },
    {
      "index": 35,
      "text": "किनारे पर ऊंची गर्म रेत आपके पीछे हटने का इंतजार कर रही है।",
      "file": "c035.ogg",
      "durationSec": 9.504
    },
    {
      "index": 36,
      "text": "बैठना। अपने हाथों को धूप में गरम अनाज में खोदें।",
      "file": "c036.ogg",
      "durationSec": 9.576
    },
    {
      "index": 37,
      "text": "नीचे ठंडी नम रेत के विरुद्ध उस सूखी गर्मी को महसूस करें।",
      "file": "c037.ogg",
      "durationSec": 9.408
    },
    {
      "index": 38,
      "text": "खुले पानी में बिखरती रोशनी को देखें।",
      "file": "c038.ogg",
      "durationSec": 6.48
    },
    {
      "index": 39,
      "text": "हवा की ताज़गी में साँस लें।",
      "file": "c039.ogg",
      "durationSec": 5.376
    },
    {
      "index": 40,
      "text": "पसलियों में अभी भी मौजूद किसी भी जकड़न को बाहर निकालें।",
      "file": "c040.ogg",
      "durationSec": 9.12
    },
    {
      "index": 41,
      "text": "एक मूर्ख एक बार रोता है और शांति का हिस्सा बन जाता है।",
      "file": "c041.ogg",
      "durationSec": 8.76
    },
    {
      "index": 42,
      "text": "वापस लेटो। अपनी आँखें बंद करें।",
      "file": "c042.ogg",
      "durationSec": 8.04
    },
    {
      "index": 43,
      "text": "आपके सामने गर्मजोशी। आपके किनारों पर शीतल पृथ्वी-छाया।",
      "file": "c043.ogg",
      "durationSec": 10.992
    },
    {
      "index": 44,
      "text": "ज्वार की लय आपके हृदय को सहजता की ओर ले जाती है।",
      "file": "c044.ogg",
      "durationSec": 8.424
    },
    {
      "index": 45,
      "text": "आप सबसे अच्छे तरीके से छोटे हैं - किसी विशाल और दयालु चीज़ द्वारा धारण किए गए।",
      "file": "c045.ogg",
      "durationSec": 12.72
    },
    {
      "index": 46,
      "text": "अपनी बंद आंखों पर सूरज की गर्माहट बरकरार रखें।",
      "file": "c046.ogg",
      "durationSec": 8.184
    },
    {
      "index": 47,
      "text": "जब हवा का रुख बदल जाए तो अपनी त्वचा पर स्प्रे के ठंडे चुंबन के साथ बने रहें।",
      "file": "c047.ogg",
      "durationSec": 11.856
    },
    {
      "index": 48,
      "text": "शांति कहीं और नहीं है. ये किनारा है, ये सांस है, ये जिस्म है.",
      "file": "c048.ogg",
      "durationSec": 12.36
    },
    {
      "index": 49,
      "text": "अपनी एड़ियों को गर्म रेत में थोड़ा और गहराई तक खोदें।",
      "file": "c049.ogg",
      "durationSec": 8.304
    },
    {
      "index": 50,
      "text": "महसूस करें कि पृथ्वी किस प्रकार स्थिर समर्थन के साथ उत्तर देती है।",
      "file": "c050.ogg",
      "durationSec": 10.704
    },
    {
      "index": 51,
      "text": "नमक की ताज़गी को फेफड़ों के निचले भाग तक साँस लें।",
      "file": "c051.ogg",
      "durationSec": 8.616
    },
    {
      "index": 52,
      "text": "जो कुछ भी प्रभाव के लिए तैयार हो रहा है, उसे बाहर निकालें।",
      "file": "c052.ogg",
      "durationSec": 9.528
    },
    {
      "index": 53,
      "text": "यहां कोई प्रभाव नहीं है. लहरों के आगमन पर ही आगमन.",
      "file": "c053.ogg",
      "durationSec": 10.128
    },
    {
      "index": 54,
      "text": "पांच सांसों को उसी धैर्यपूर्ण लय में चलने दें।",
      "file": "c054.ogg",
      "durationSec": 7.536
    },
    {
      "index": 55,
      "text": "फिर त्वचा पर सूरज की रोशनी के बाद आराम करें।",
      "file": "c055.ogg",
      "durationSec": 7.848
    },
    {
      "index": 56,
      "text": "उठें और जलरेखा पर कुछ दूर चलें।",
      "file": "c056.ogg",
      "durationSec": 6.288
    },
    {
      "index": 57,
      "text": "बायां पैर ठंडा और गीला है। दाहिना पैर गर्म और सूखा। फिर स्विच करें.",
      "file": "c057.ogg",
      "durationSec": 14.544
    },
    {
      "index": 58,
      "text": "शरीर विरोधाभास को आराम के रूप में सीखता है, संघर्ष के रूप में नहीं।",
      "file": "c058.ogg",
      "durationSec": 11.112
    },
    {
      "index": 59,
      "text": "प्रकाश से गरम किया हुआ एक चिकना पत्थर उठाओ।",
      "file": "c059.ogg",
      "durationSec": 7.824
    },
    {
      "index": 60,
      "text": "हथेली में इसकी गर्मी महसूस करें. इसका घनत्व. यह शांत है।",
      "file": "c060.ogg",
      "durationSec": 11.208
    },
    {
      "index": 61,
      "text": "इसे धन्यवाद के साथ रख दें - इसे रखने की कोई आवश्यकता नहीं है।",
      "file": "c061.ogg",
      "durationSec": 10.464
    },
    {
      "index": 62,
      "text": "रखना अंदर की ओर है.",
      "file": "c062.ogg",
      "durationSec": 4.608
    },
    {
      "index": 63,
      "text": "रंग को शांत करने के लिए ब्रेकरों के पीछे देखें।",
      "file": "c063.ogg",
      "durationSec": 7.8
    },
    {
      "index": 64,
      "text": "ऐसे साँस लें जैसे कि आप नीले रंग का स्वाद ले सकें।",
      "file": "c064.ogg",
      "durationSec": 9.504
    },
    {
      "index": 65,
      "text": "ताज़ी हवा। गरम गाल. मुलायम पेट.",
      "file": "c065.ogg",
      "durationSec": 9.816
    },
    {
      "index": 66,
      "text": "अगली श्वास को अभ्यास की सबसे गहरी श्वास लेने दें।",
      "file": "c066.ogg",
      "durationSec": 8.328
    },
    {
      "index": 67,
      "text": "श्वास को बिना बल के खाली होने दें।",
      "file": "c067.ogg",
      "durationSec": 5.928
    },
    {
      "index": 68,
      "text": "खाड़ी, चट्टान, घर का रास्ता - सभी बिना किसी दबाव के प्रतीक्षा करते हैं।",
      "file": "c068.ogg",
      "durationSec": 11.928
    },
    {
      "index": 69,
      "text": "अब कहानी को विराम दीजिए और सनसनी पर कायम रहिए।",
      "file": "c069.ogg",
      "durationSec": 8.16
    },
    {
      "index": 70,
      "text": "इस जगह की ताजगी का आनंद लें।",
      "file": "c070.ogg",
      "durationSec": 5.76
    },
    {
      "index": 71,
      "text": "इसकी गर्माहट और शांति में सांस छोड़ें।",
      "file": "c071.ogg",
      "durationSec": 6.648
    },
    {
      "index": 72,
      "text": "श्वास लें.",
      "file": "c072.ogg",
      "durationSec": 3.168
    },
    {
      "index": 73,
      "text": "साँस छोड़ें।",
      "file": "c073.ogg",
      "durationSec": 3.672
    },
    {
      "index": 74,
      "text": "दोबारा। नरम श्वास.",
      "file": "c074.ogg",
      "durationSec": 6.744
    },
    {
      "index": 75,
      "text": "लंबी सांस छोड़ें.",
      "file": "c075.ogg",
      "durationSec": 4.248
    },
    {
      "index": 76,
      "text": "इस कल्पित संसार की ज़मीन से चिपके हुए शरीर को महसूस करें।",
      "file": "c076.ogg",
      "durationSec": 9.6
    },
    {
      "index": 77,
      "text": "श्वास लें.",
      "file": "c077.ogg",
      "durationSec": 3.168
    },
    {
      "index": 78,
      "text": "साँस छोड़ें।",
      "file": "c078.ogg",
      "durationSec": 3.672
    },
    {
      "index": 79,
      "text": "यदि विचार भटकते हैं, तो त्वचा पर गर्माहट लौटाएँ।",
      "file": "c079.ogg",
      "durationSec": 8.784
    },
    {
      "index": 80,
      "text": "या नाक पर हवा को ठंडा करने के लिए.",
      "file": "c080.ogg",
      "durationSec": 6.336
    },
    {
      "index": 81,
      "text": "श्वास लें.",
      "file": "c081.ogg",
      "durationSec": 3.168
    },
    {
      "index": 82,
      "text": "साँस छोड़ें।",
      "file": "c082.ogg",
      "durationSec": 3.672
    },
    {
      "index": 83,
      "text": "श्वास लें.",
      "file": "c083.ogg",
      "durationSec": 3.168
    },
    {
      "index": 84,
      "text": "साँस छोड़ें।",
      "file": "c084.ogg",
      "durationSec": 3.672
    },
    {
      "index": 85,
      "text": "रहना। नरम करना. जारी रखना।",
      "file": "c085.ogg",
      "durationSec": 9.24
    },
    {
      "index": 86,
      "text": "श्वास लें.",
      "file": "c086.ogg",
      "durationSec": 3.168
    },
    {
      "index": 87,
      "text": "साँस छोड़ें।",
      "file": "c087.ogg",
      "durationSec": 3.672
    },
    {
      "index": 88,
      "text": "एक और आसान चक्र.",
      "file": "c088.ogg",
      "durationSec": 4.488
    },
    {
      "index": 89,
      "text": "श्वास लें.",
      "file": "c089.ogg",
      "durationSec": 3.168
    },
    {
      "index": 90,
      "text": "साँस छोड़ें।",
      "file": "c090.ogg",
      "durationSec": 3.672
    },
    {
      "index": 91,
      "text": "कुछ और सांसों के लिए इस भावना में बने रहें।",
      "file": "c091.ogg",
      "durationSec": 6.768
    },
    {
      "index": 92,
      "text": "गर्मी। कोमलता. पर्याप्तता.",
      "file": "c092.ogg",
      "durationSec": 8.88
    },
    {
      "index": 93,
      "text": "जब भी आपको आवश्यकता हो आप इस स्थान पर वापस आ सकते हैं।",
      "file": "c093.ogg",
      "durationSec": 9.216
    },
    {
      "index": 94,
      "text": "यह केवल कल्पना में नहीं बल्कि आपके ध्यान में रहता है।",
      "file": "c094.ogg",
      "durationSec": 8.304
    },
    {
      "index": 95,
      "text": "श्वास को गहरा करना शुरू करें।",
      "file": "c095.ogg",
      "durationSec": 5.592
    },
    {
      "index": 96,
      "text": "अपने आस-पास के कमरे को फिर से महसूस करें।",
      "file": "c096.ogg",
      "durationSec": 7.632
    },
    {
      "index": 97,
      "text": "उँगलियाँ हिलाओ. पैर की उंगलियों को नरम करें.",
      "file": "c097.ogg",
      "durationSec": 9.216
    },
    {
      "index": 98,
      "text": "जब आप तैयार हों तो अपनी आँखें खोलें।",
      "file": "c098.ogg",
      "durationSec": 6.96
    },
    {
      "index": 99,
      "text": "एक और आसान साँस लें.",
      "file": "c099.ogg",
      "durationSec": 5.088
    },
    {
      "index": 100,
      "text": "आगे जो भी आए उसमें इस शांति को बनाए रखें।",
      "file": "c100.ogg",
      "durationSec": 7.728
    }
  ]
}
