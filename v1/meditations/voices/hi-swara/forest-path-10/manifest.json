{
  "id": "forest-path-10",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 826,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "ऐसा आसन खोजें जो आपसे कुछ न पूछे।",
      "file": "c001.ogg",
      "durationSec": 7.608
    },
    {
      "index": 2,
      "text": "आपको जिस भी सहारे की आवश्यकता हो, उसके साथ बैठें या लेटें।",
      "file": "c002.ogg",
      "durationSec": 10.464
    },
    {
      "index": 3,
      "text": "अपने हाथों को खुला या मुलायम रहने दें।",
      "file": "c003.ogg",
      "durationSec": 6.336
    },
    {
      "index": 4,
      "text": "अपनी आँखों को बंद होने दें, या नरम नज़र रखें।",
      "file": "c004.ogg",
      "durationSec": 8.16
    },
    {
      "index": 5,
      "text": "उन स्थानों को महसूस करें जहां आपका शरीर जमीन से मिलता है।",
      "file": "c005.ogg",
      "durationSec": 9.648
    },
    {
      "index": 6,
      "text": "एड़ियाँ, बैठने की हड्डियाँ, सिर का पिछला भाग, या रीढ़ की हड्डी की लंबाई।",
      "file": "c006.ogg",
      "durationSec": 12.168
    },
    {
      "index": 7,
      "text": "अभी रुकने के लिए कुछ भी नहीं है.",
      "file": "c007.ogg",
      "durationSec": 5.544
    },
    {
      "index": 8,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c008.ogg",
      "durationSec": 6.048
    },
    {
      "index": 9,
      "text": "आती हुई हवा की ठंडक को महसूस करें।",
      "file": "c009.ogg",
      "durationSec": 6.792
    },
    {
      "index": 10,
      "text": "और थोड़ी देर सांस छोड़ें.",
      "file": "c010.ogg",
      "durationSec": 5.208
    },
    {
      "index": 11,
      "text": "बाहर निकलती सांस की गर्माहट को महसूस करें।",
      "file": "c011.ogg",
      "durationSec": 7.776
    },
    {
      "index": 12,
      "text": "दोबारा। नरम श्वास.",
      "file": "c012.ogg",
      "durationSec": 6.744
    },
    {
      "index": 13,
      "text": "बिना जल्दबाजी के साँस छोड़ें।",
      "file": "c013.ogg",
      "durationSec": 5.808
    },
    {
      "index": 14,
      "text": "कंधों को थोड़ा सा गिरने दें।",
      "file": "c014.ogg",
      "durationSec": 5.184
    },
    {
      "index": 15,
      "text": "जबड़े को खुला रहने दो.",
      "file": "c015.ogg",
      "durationSec": 4.848
    },
    {
      "index": 16,
      "text": "पेट को नरम रहने दें.",
      "file": "c016.ogg",
      "durationSec": 4.656
    },
    {
      "index": 17,
      "text": "तीन शांत सांसों के साथ वैसे ही रहें जैसे वे हैं।",
      "file": "c017.ogg",
      "durationSec": 7.776
    },
    {
      "index": 18,
      "text": "श्वास लें. आना।",
      "file": "c018.ogg",
      "durationSec": 5.736
    },
    {
      "index": 19,
      "text": "साँस छोड़ें। निपटारा करना।",
      "file": "c019.ogg",
      "durationSec": 7.056
    },
    {
      "index": 20,
      "text": "यदि मन भटकता है, तो कृपया उस पर ध्यान दें, और इस सांस पर वापस आएँ।",
      "file": "c020.ogg",
      "durationSec": 12.12
    },
    {
      "index": 21,
      "text": "अब एक पुराने जंगल में धीमी गति से चलना शुरू करें।",
      "file": "c021.ogg",
      "durationSec": 8.304
    },
    {
      "index": 22,
      "text": "रास्ता सुइयों और गिरी हुई पत्तियों से नरम है।",
      "file": "c022.ogg",
      "durationSec": 7.416
    },
    {
      "index": 23,
      "text": "प्रत्येक कदम पर एक शांत ध्वनि उत्पन्न होती है, फिर मौन लौट आता है।",
      "file": "c023.ogg",
      "durationSec": 10.536
    },
    {
      "index": 24,
      "text": "सूरज की रोशनी गर्म रिबन में ऊंची शाखाओं के माध्यम से गुजरती है।",
      "file": "c024.ogg",
      "durationSec": 10.56
    },
    {
      "index": 25,
      "text": "अपनी बांह पर सूरज का एक टुकड़ा महसूस करें - अचानक हल्की गर्मी।",
      "file": "c025.ogg",
      "durationSec": 10.32
    },
    {
      "index": 26,
      "text": "फिर दोबारा छाया दें, ठंडा और हरा।",
      "file": "c026.ogg",
      "durationSec": 7.08
    },
    {
      "index": 27,
      "text": "हवा का एक झोंका छत्र को हिला देता है। ताजी हवा आपका चेहरा ढूंढ़ लेती है।",
      "file": "c027.ogg",
      "durationSec": 12.984
    },
    {
      "index": 28,
      "text": "गंध राल, नम मिट्टी, और काई की साफ मिठास।",
      "file": "c028.ogg",
      "durationSec": 8.688
    },
    {
      "index": 29,
      "text": "विराम। खुरदुरी छाल पर हथेली रखें।",
      "file": "c029.ogg",
      "durationSec": 8.472
    },
    {
      "index": 30,
      "text": "महसूस करें कि पेड़ की शांति आपके हाथ में प्रवेश कर रही है।",
      "file": "c030.ogg",
      "durationSec": 9.432
    },
    {
      "index": 31,
      "text": "गहराई से जारी रखें. बाहरी दुनिया की आवाजें दूर हो जाती हैं।",
      "file": "c031.ogg",
      "durationSec": 11.64
    },
    {
      "index": 32,
      "text": "कहीं कोई धारा छोटे-छोटे चमकीले अक्षरों में बोलती है।",
      "file": "c032.ogg",
      "durationSec": 8.28
    },
    {
      "index": 33,
      "text": "आप तब तक अनुसरण करें जब तक पत्थरों के बीच पानी दिखाई न दे।",
      "file": "c033.ogg",
      "durationSec": 9.912
    },
    {
      "index": 34,
      "text": "घुटने टेकना. अपने हाथ डुबाओ. बढ़िया स्पष्टता.",
      "file": "c034.ogg",
      "durationSec": 11.472
    },
    {
      "index": 35,
      "text": "अपनी कलाइयों पर थोड़ा सा छिड़कें. त्वचा में ताजगी जागती है।",
      "file": "c035.ogg",
      "durationSec": 10.56
    },
    {
      "index": 36,
      "text": "सूर्य के एक संकीर्ण स्तंभ द्वारा गर्म की गई सपाट चट्टान पर बैठें।",
      "file": "c036.ogg",
      "durationSec": 10.728
    },
    {
      "index": 37,
      "text": "अपनी बैठने की हड्डियों और अपनी जांघों के पिछले हिस्से में उस गर्माहट को महसूस करें।",
      "file": "c037.ogg",
      "durationSec": 12.792
    },
    {
      "index": 38,
      "text": "अपनी पिंडलियों पर धारा की ठंडी सांस को महसूस करें।",
      "file": "c038.ogg",
      "durationSec": 8.568
    },
    {
      "index": 39,
      "text": "पंछी एक बार आवाज देते हैं, फिर शांत हो जाते हैं।",
      "file": "c039.ogg",
      "durationSec": 8.664
    },
    {
      "index": 40,
      "text": "जंगल की ताजगी में सांस लें।",
      "file": "c040.ogg",
      "durationSec": 5.856
    },
    {
      "index": 41,
      "text": "अपने आस-पास के रोगी धड़ों में साँस छोड़ें।",
      "file": "c041.ogg",
      "durationSec": 7.392
    },
    {
      "index": 42,
      "text": "ध्यान दें कि बिना पूछे आपके कंधे कैसे झुक गए हैं।",
      "file": "c042.ogg",
      "durationSec": 8.976
    },
    {
      "index": 43,
      "text": "जब कोई और जगह नहीं होती तो जबड़ा कैसे नरम हो जाता है।",
      "file": "c043.ogg",
      "durationSec": 8.808
    },
    {
      "index": 44,
      "text": "जब आप तैयार हों तो खड़े हो जाएं और थोड़ा आगे चलें।",
      "file": "c044.ogg",
      "durationSec": 9.12
    },
    {
      "index": 45,
      "text": "फ़र्न आपकी पिंडलियों को ठंडी हरी उंगलियों से ब्रश करते हैं।",
      "file": "c045.ogg",
      "durationSec": 8.424
    },
    {
      "index": 46,
      "text": "एक समाशोधन खुलता है - रुकी हुई सांस की तरह गोल।",
      "file": "c046.ogg",
      "durationSec": 8.856
    },
    {
      "index": 47,
      "text": "गहरी काई पर पीठ के बल लेटें।",
      "file": "c047.ogg",
      "durationSec": 5.784
    },
    {
      "index": 48,
      "text": "पृथ्वी तुम्हारा भार पूर्णतः ग्रहण करती है।",
      "file": "c048.ogg",
      "durationSec": 6.984
    },
    {
      "index": 49,
      "text": "आपके चेहरे पर छनती धूप की गर्माहट।",
      "file": "c049.ogg",
      "durationSec": 6.72
    },
    {
      "index": 50,
      "text": "आपकी रीढ़ की हड्डी पर काई की ठंडक।",
      "file": "c050.ogg",
      "durationSec": 6.768
    },
    {
      "index": 51,
      "text": "हवा आती है, चली जाती है, फिर आती है।",
      "file": "c051.ogg",
      "durationSec": 7.488
    },
    {
      "index": 52,
      "text": "किसी जीवित स्थान द्वारा धारण किए जाने की भावना के साथ रहें।",
      "file": "c052.ogg",
      "durationSec": 9.12
    },
    {
      "index": 53,
      "text": "सुरक्षित। शांत। बिना प्रयास के अपनापन.",
      "file": "c053.ogg",
      "durationSec": 10.992
    },
    {
      "index": 54,
      "text": "यहां पांच धीमी सांसें गिनें, हर एक धीमी।",
      "file": "c054.ogg",
      "durationSec": 7.848
    },
    {
      "index": 55,
      "text": "गंध पर फिर से ध्यान दें - हरा, नम, ईमानदार।",
      "file": "c055.ogg",
      "durationSec": 8.976
    },
    {
      "index": 56,
      "text": "ध्वनि पर फिर से ध्यान दें - लगभग कोई नहीं, और वह बहुत है।",
      "file": "c056.ogg",
      "durationSec": 10.08
    },
    {
      "index": 57,
      "text": "यदि कोई विचार आता है, तो उसे धारा में पत्ते की तरह बहने दें।",
      "file": "c057.ogg",
      "durationSec": 9.912
    },
    {
      "index": 58,
      "text": "जहां भी सूरज आपको मिले वहां त्वचा पर गर्माहट लौटाएं।",
      "file": "c058.ogg",
      "durationSec": 9.144
    },
    {
      "index": 59,
      "text": "उन गर्म रिबन के बीच छाया में ठंडक की ओर लौटें।",
      "file": "c059.ogg",
      "durationSec": 8.16
    },
    {
      "index": 60,
      "text": "आप काफी अंदर तक चल चुके हैं।",
      "file": "c060.ogg",
      "durationSec": 5.784
    },
    {
      "index": 61,
      "text": "तीन धीमी सांसों को इसे शरीर में सील करने दें।",
      "file": "c061.ogg",
      "durationSec": 7.656
    },
    {
      "index": 62,
      "text": "जाने से पहले, एक बार फिर धारा के पास खड़े हो जाओ।",
      "file": "c062.ogg",
      "durationSec": 9.192
    },
    {
      "index": 63,
      "text": "पत्थरों के चारों ओर साफ पानी की चोटी देखें।",
      "file": "c063.ogg",
      "durationSec": 7.992
    },
    {
      "index": 64,
      "text": "चलती हुई सतह से ठंडी हवा ऊपर उठती है।",
      "file": "c064.ogg",
      "durationSec": 7.224
    },
    {
      "index": 65,
      "text": "गर्म रोशनी अभी भी आपके अग्रबाहु की एक पट्टी ढूंढती है।",
      "file": "c065.ogg",
      "durationSec": 9.432
    },
    {
      "index": 66,
      "text": "यदि आप चाहें तो एक कप पानी लें और भौंह को गीला कर लें - कल्पना में, शांत और दयालु।",
      "file": "c066.ogg",
      "durationSec": 14.088
    },
    {
      "index": 67,
      "text": "जंगल तालियाँ नहीं बजाता. यह बस जारी है.",
      "file": "c067.ogg",
      "durationSec": 8.76
    },
    {
      "index": 68,
      "text": "वह निरंतरता ही गुरु है.",
      "file": "c068.ogg",
      "durationSec": 4.776
    },
    {
      "index": 69,
      "text": "मन में कुछ शांत कदम बाहर की ओर चलें।",
      "file": "c069.ogg",
      "durationSec": 6.648
    },
    {
      "index": 70,
      "text": "पैरों के नीचे सुईयाँ. मुलायम ध्वनि। नरम वापसी.",
      "file": "c070.ogg",
      "durationSec": 11.52
    },
    {
      "index": 71,
      "text": "फिर भी समाशोधन की शांति संग्रहीत सूरज की तरह छाती में रहती है।",
      "file": "c071.ogg",
      "durationSec": 9.888
    },
    {
      "index": 72,
      "text": "इसे वहां महसूस करें - उरोस्थि के पीछे गर्माहट।",
      "file": "c072.ogg",
      "durationSec": 8.688
    },
    {
      "index": 73,
      "text": "नासिका छिद्रों में अभी भी ताजगी महसूस करें।",
      "file": "c073.ogg",
      "durationSec": 7.872
    },
    {
      "index": 74,
      "text": "आप दोनों को साधारण कमरे में ला सकते हैं।",
      "file": "c074.ogg",
      "durationSec": 6.672
    },
    {
      "index": 75,
      "text": "आखिरी बार शाखाओं के माध्यम से आकाश के एक सिक्के की ओर देखें।",
      "file": "c075.ogg",
      "durationSec": 10.008
    },
    {
      "index": 76,
      "text": "पर्याप्त।",
      "file": "c076.ogg",
      "durationSec": 3.096
    },
    {
      "index": 77,
      "text": "अब कहानी को विराम दीजिए और सनसनी पर कायम रहिए।",
      "file": "c077.ogg",
      "durationSec": 8.16
    },
    {
      "index": 78,
      "text": "इस जगह की ताजगी का आनंद लें।",
      "file": "c078.ogg",
      "durationSec": 5.76
    },
    {
      "index": 79,
      "text": "इसकी गर्माहट और शांति में सांस छोड़ें।",
      "file": "c079.ogg",
      "durationSec": 6.648
    },
    {
      "index": 80,
      "text": "श्वास लें.",
      "file": "c080.ogg",
      "durationSec": 3.168
    },
    {
      "index": 81,
      "text": "साँस छोड़ें।",
      "file": "c081.ogg",
      "durationSec": 3.672
    },
    {
      "index": 82,
      "text": "दोबारा। नरम श्वास.",
      "file": "c082.ogg",
      "durationSec": 6.744
    },
    {
      "index": 83,
      "text": "लंबी सांस छोड़ें.",
      "file": "c083.ogg",
      "durationSec": 4.248
    },
    {
      "index": 84,
      "text": "इस कल्पित संसार की ज़मीन से चिपके हुए शरीर को महसूस करें।",
      "file": "c084.ogg",
      "durationSec": 9.6
    },
    {
      "index": 85,
      "text": "श्वास लें.",
      "file": "c085.ogg",
      "durationSec": 3.168
    },
    {
      "index": 86,
      "text": "साँस छोड़ें।",
      "file": "c086.ogg",
      "durationSec": 3.672
    },
    {
      "index": 87,
      "text": "यदि विचार भटकते हैं, तो त्वचा पर गर्माहट लौटाएँ।",
      "file": "c087.ogg",
      "durationSec": 8.784
    },
    {
      "index": 88,
      "text": "या नाक पर हवा को ठंडा करने के लिए.",
      "file": "c088.ogg",
      "durationSec": 6.336
    },
    {
      "index": 89,
      "text": "श्वास लें.",
      "file": "c089.ogg",
      "durationSec": 3.168
    },
    {
      "index": 90,
      "text": "साँस छोड़ें।",
      "file": "c090.ogg",
      "durationSec": 3.672
    },
    {
      "index": 91,
      "text": "श्वास लें.",
      "file": "c091.ogg",
