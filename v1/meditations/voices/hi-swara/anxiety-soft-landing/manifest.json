{
  "id": "anxiety-soft-landing",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 188,
  "chunks": [
    {
      "index": 0,
      "text": "यदि आप सक्रिय या चिंतित महसूस करते हैं, तो आपका यहां स्वागत है।",
      "file": "c000.ogg",
      "durationSec": 10.488
    },
    {
      "index": 1,
      "text": "आपको अभी शांत महसूस करने की आवश्यकता नहीं है।",
      "file": "c001.ogg",
      "durationSec": 8.136
    },
    {
      "index": 2,
      "text": "बस साथ चलो.",
      "file": "c002.ogg",
      "durationSec": 3.864
    },
    {
      "index": 3,
      "text": "यदि संभव हो तो दोनों पैरों को फर्श पर रखें।",
      "file": "c003.ogg",
      "durationSec": 7.752
    },
    {
      "index": 4,
      "text": "संपर्क महसूस करो. ऊँची एड़ी के जूते। पैरों की गेंदें. पैर की उँगलियाँ।",
      "file": "c004.ogg",
      "durationSec": 16.176
    },
    {
      "index": 5,
      "text": "धीरे से दबाएँ. ज़मीन से पीछे की ओर धकेले जाने पर ध्यान दें।",
      "file": "c005.ogg",
      "durationSec": 11.616
    },
    {
      "index": 6,
      "text": "पाँच चीज़ों के नाम बताइए जिन्हें आप देख सकते हैं।",
      "file": "c006.ogg",
      "durationSec": 8.232
    },
    {
      "index": 7,
      "text": "चुपचाप. कोई जल्दी नहीं।",
      "file": "c007.ogg",
      "durationSec": 7.152
    },
    {
      "index": 8,
      "text": "चार चीज़ों के नाम बताइए जिन्हें आप छू सकते हैं।",
      "file": "c008.ogg",
      "durationSec": 8.136
    },
    {
      "index": 9,
      "text": "कपड़े। कुर्सी। त्वचा पर हवा.",
      "file": "c009.ogg",
      "durationSec": 8.832
    },
    {
      "index": 10,
      "text": "निकट या दूर, तीन ध्वनियों के नाम बताइए।",
      "file": "c010.ogg",
      "durationSec": 7.488
    },
    {
      "index": 11,
      "text": "दो गंधों के नाम बताएं, या बस हवा पर ध्यान दें।",
      "file": "c011.ogg",
      "durationSec": 8.4
    },
    {
      "index": 12,
      "text": "किसी एक स्वाद या मुँह में होने वाली अनुभूति का नाम बताइए।",
      "file": "c012.ogg",
      "durationSec": 8.928
    },
    {
      "index": 13,
      "text": "आप यहां हैं। इस शरीर में. इस कमरे में.",
      "file": "c013.ogg",
      "durationSec": 9.6
    },
    {
      "index": 14,
      "text": "अब चार तक सांस अंदर लें।",
      "file": "c014.ogg",
      "durationSec": 5.136
    },
    {
      "index": 15,
      "text": "दो के लिए धीरे से पकड़ें।",
      "file": "c015.ogg",
      "durationSec": 5.136
    },
    {
      "index": 16,
      "text": "छह रन पर आउट.",
      "file": "c016.ogg",
      "durationSec": 3.84
    },
    {
      "index": 17,
      "text": "यदि आप चाहें तो पुनः.",
      "file": "c017.ogg",
      "durationSec": 5.136
    },
    {
      "index": 18,
      "text": "एक हाथ छाती या पेट पर रखें।",
      "file": "c018.ogg",
      "durationSec": 5.808
    },
    {
      "index": 19,
      "text": "अपने हाथ के नीचे हलचल महसूस करें।",
      "file": "c019.ogg",
      "durationSec": 6.792
    },
    {
      "index": 20,
      "text": "चिंता अभी भी बनी रह सकती है. इसकी अनुमति है.",
      "file": "c020.ogg",
      "durationSec": 9.168
    },
    {
      "index": 21,
      "text": "आपने तंत्रिका तंत्र को एक नरम लैंडिंग दी है।",
      "file": "c021.ogg",
      "durationSec": 7.464
    },
    {
      "index": 22,
      "text": "एक और सांस लीजिए.",
      "file": "c022.ogg",
      "durationSec": 4.464
    },
    {
      "index": 23,
      "text": "तैयार होने पर, अपनी आँखें खोलें और अपना दिन जारी रखें।",
      "file": "c023.ogg",
      "durationSec": 10.032
    }
  ]
}
