  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट ढूंढें, या यदि बेहतर लगे तो लेट जाएं।",
      "file": "c001.ogg",
      "durationSec": 10.368
    },
    {
      "index": 2,
      "text": "हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.272
    },
    {
      "index": 3,
      "text": "आँखें नरम करें, या उन्हें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 6.768
    },
    {
      "index": 4,
      "text": "धीरे-धीरे सांस अंदर लें.",
      "file": "c004.ogg",
      "durationSec": 5.16
    },
    {
      "index": 5,
      "text": "और एक लंबी सांस छोड़ें.",
      "file": "c005.ogg",
      "durationSec": 5.088
    },
    {
      "index": 6,
      "text": "कुछ चक्रों के लिए सांस से शुरुआत करें।",
      "file": "c006.ogg",
      "durationSec": 6.552
    },
    {
      "index": 7,
      "text": "[विराम:28]",
      "file": "c007.ogg",
      "durationSec": 4.632
    },
    {
      "index": 8,
      "text": "अब चौड़ा करो. ध्वनियाँ शामिल करें.",
      "file": "c008.ogg",
      "durationSec": 7.92
    },
    {
      "index": 9,
      "text": "पास में। दूर। बदल रहा है. नियमित।",
      "file": "c009.ogg",
      "durationSec": 11.88
    },
    {
      "index": 10,
      "text": "[विराम:28]",
      "file": "c010.ogg",
      "durationSec": 4.632
    },
    {
      "index": 11,
      "text": "शरीर में संवेदनाओं को शामिल करें.",
      "file": "c011.ogg",
      "durationSec": 6.216
    },
    {
      "index": 12,
      "text": "अनुबंध के निर्देश। तापमान। नरम नाड़ी.",
      "file": "c012.ogg",
      "durationSec": 10.68
    },
    {
      "index": 13,
      "text": "[विराम:28]",
      "file": "c013.ogg",
      "durationSec": 4.632
    },
    {
      "index": 14,
      "text": "कमरे का स्थान शामिल करें.",
      "file": "c014.ogg",
      "durationSec": 5.208
    },
    {
      "index": 15,
      "text": "जागरूकता खुले आसमान की तरह.",
      "file": "c015.ogg",
      "durationSec": 6.048
    },
    {
      "index": 16,
      "text": "[विराम:34]",
      "file": "c016.ogg",
      "durationSec": 4.8
    },
    {
      "index": 17,
      "text": "विचार मौसम की तरह लग सकते हैं।",
      "file": "c017.ogg",
      "durationSec": 5.784
    },
    {
      "index": 18,
      "text": "उनका पीछा करने या धक्का देने की जरूरत नहीं है.",
      "file": "c018.ogg",
      "durationSec": 7.728
    },
    {
      "index": 19,
      "text": "आकाश बाकी है.",
      "file": "c019.ogg",
      "durationSec": 3.816
    },
    {
      "index": 20,
      "text": "[विराम:45]",
      "file": "c020.ogg",
      "durationSec": 5.04
    },
    {
      "index": 21,
      "text": "इस खुले मैदान में आराम करो.",
      "file": "c021.ogg",
      "durationSec": 5.4
    },
    {
      "index": 22,
      "text": "[विराम:45]",
      "file": "c022.ogg",
      "durationSec": 5.04
    },
    {
      "index": 23,
      "text": "एक और आसान साँस लें.",
      "file": "c023.ogg",
      "durationSec": 5.088
    },
    {
      "index": 24,
      "text": "उँगलियाँ हिलाओ.",
      "file": "c024.ogg",
      "durationSec": 3.864
    },
    {
      "index": 25,
      "text": "जब आप तैयार हों तो आँखें खोलें।",
      "file": "c025.ogg",
      "durationSec": 6.216
    },
    {
      "index": 26,
      "text": "इसमें से थोड़ा सा अपने साथ ले जाओ.",
      "file": "c026.ogg",
      "durationSec": 6.504
    }
  ]
}
