{
  "id": "lake-wander-10",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 800,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "ऐसा आसन खोजें जो आपसे कुछ न पूछे।",
      "file": "c001.ogg",
      "durationSec": 7.608
    },
    {
      "index": 2,
      "text": "आपको जिस भी सहारे की आवश्यकता हो, उसके साथ बैठें या लेटें।",
      "file": "c002.ogg",
      "durationSec": 10.464
    },
    {
      "index": 3,
      "text": "अपने हाथों को खुला या मुलायम रहने दें।",
      "file": "c003.ogg",
      "durationSec": 6.336
    },
    {
      "index": 4,
      "text": "अपनी आँखों को बंद होने दें, या नरम नज़र रखें।",
      "file": "c004.ogg",
      "durationSec": 8.16
    },
    {
      "index": 5,
      "text": "उन स्थानों को महसूस करें जहां आपका शरीर जमीन से मिलता है।",
      "file": "c005.ogg",
      "durationSec": 9.648
    },
    {
      "index": 6,
      "text": "एड़ियाँ, बैठने की हड्डियाँ, सिर का पिछला भाग, या रीढ़ की हड्डी की लंबाई।",
      "file": "c006.ogg",
      "durationSec": 12.168
    },
    {
      "index": 7,
      "text": "अभी रुकने के लिए कुछ भी नहीं है.",
      "file": "c007.ogg",
      "durationSec": 5.544
    },
    {
      "index": 8,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c008.ogg",
      "durationSec": 6.048
    },
    {
      "index": 9,
      "text": "आती हुई हवा की ठंडक को महसूस करें।",
      "file": "c009.ogg",
      "durationSec": 6.792
    },
    {
      "index": 10,
      "text": "और थोड़ी देर सांस छोड़ें.",
      "file": "c010.ogg",
      "durationSec": 5.208
    },
    {
      "index": 11,
      "text": "बाहर निकलती सांस की गर्माहट को महसूस करें।",
      "file": "c011.ogg",
      "durationSec": 7.776
    },
    {
      "index": 12,
      "text": "दोबारा। नरम श्वास.",
      "file": "c012.ogg",
      "durationSec": 6.744
    },
    {
      "index": 13,
      "text": "बिना जल्दबाजी के साँस छोड़ें।",
      "file": "c013.ogg",
      "durationSec": 5.808
    },
    {
      "index": 14,
      "text": "कंधों को थोड़ा सा गिरने दें।",
      "file": "c014.ogg",
      "durationSec": 5.184
    },
    {
      "index": 15,
      "text": "जबड़े को खुला रहने दो.",
      "file": "c015.ogg",
      "durationSec": 4.848
    },
    {
      "index": 16,
      "text": "पेट को नरम रहने दें.",
      "file": "c016.ogg",
      "durationSec": 4.656
    },
    {
      "index": 17,
      "text": "तीन शांत सांसों के साथ वैसे ही रहें जैसे वे हैं।",
      "file": "c017.ogg",
      "durationSec": 7.776
    },
    {
      "index": 18,
      "text": "श्वास लें. आना।",
      "file": "c018.ogg",
      "durationSec": 5.736
    },
    {
      "index": 19,
      "text": "साँस छोड़ें। निपटारा करना।",
      "file": "c019.ogg",
      "durationSec": 7.056
    },
    {
      "index": 20,
      "text": "यदि मन भटकता है, तो कृपया उस पर ध्यान दें, और इस सांस पर वापस आएँ।",
      "file": "c020.ogg",
      "durationSec": 12.12
    },
    {
      "index": 21,
      "text": "एक विस्तृत शांत झील के किनारे जागने की कल्पना करें।",
      "file": "c021.ogg",
      "durationSec": 8.376
    },
    {
      "index": 22,
      "text": "सुबह की रोशनी पानी पर नरम होती है।",
      "file": "c022.ogg",
      "durationSec": 6.336
    },
    {
      "index": 23,
      "text": "ठंडी हवा एक स्वच्छ ताजगी के साथ आपके गालों को छूती है।",
      "file": "c023.ogg",
      "durationSec": 9.312
    },
    {
      "index": 24,
      "text": "पहला सूरज आपके पैरों के शीर्ष को गर्म करता है।",
      "file": "c024.ogg",
      "durationSec": 7.704
    },
    {
      "index": 25,
      "text": "आप किनारे पर धीमी गति से चलना शुरू करते हैं।",
      "file": "c025.ogg",
      "durationSec": 7.488
    },
    {
      "index": 26,
      "text": "रेत और छोटे चिकने पत्थर पैरों के नीचे से धीरे-धीरे खिसकते हैं।",
      "file": "c026.ogg",
      "durationSec": 9.816
    },
    {
      "index": 27,
      "text": "प्रत्येक चरण ज़मीन के साथ एक शांत वार्तालाप है।",
      "file": "c027.ogg",
      "durationSec": 7.728
    },
    {
      "index": 28,
      "text": "पानी से एक हवा निकलती है - ताज़ा, हल्की ठंडी।",
      "file": "c028.ogg",
      "durationSec": 8.64
    },
    {
      "index": 29,
      "text": "यह आपकी कनपटी के बालों को ऊपर उठाता है।",
      "file": "c029.ogg",
      "durationSec": 7.224
    },
    {
      "index": 30,
      "text": "देवदार की महक, गीले पत्थर और खुली सुबह।",
      "file": "c030.ogg",
      "durationSec": 8.376
    },
    {
      "index": 31,
      "text": "उथले पानी में एक बगुले को बिल्कुल शांत खड़े हुए देखें।",
      "file": "c031.ogg",
      "durationSec": 8.856
    },
    {
      "index": 32,
      "text": "आप कुछ सांसों के लिए उस शांति का मिलान करते हैं।",
      "file": "c032.ogg",
      "durationSec": 7.368
    },
    {
      "index": 33,
      "text": "जैसे-जैसे सूरज चढ़ता है आपके कंधों पर गर्माहट बढ़ती है।",
      "file": "c033.ogg",
      "durationSec": 9.216
    },
    {
      "index": 34,
      "text": "सूरज की रोशनी वाली एक चट्टान ढूंढें और बैठें।",
      "file": "c034.ogg",
      "durationSec": 8.64
    },
    {
      "index": 35,
      "text": "पत्थर में संग्रहीत गर्मी को अपने शरीर में बढ़ते हुए महसूस करें।",
      "file": "c035.ogg",
      "durationSec": 9.624
    },
    {
      "index": 36,
      "text": "प्रत्येक साँस के साथ ताजी हवा को अपने होठों पर आते हुए महसूस करें।",
      "file": "c036.ogg",
      "durationSec": 10.872
    },
    {
      "index": 37,
      "text": "झील की सतह झुर्रीदार हो जाती है, फिर कांच बन जाती है।",
      "file": "c037.ogg",
      "durationSec": 9.192
    },
    {
      "index": 38,
      "text": "प्रकाश वहाँ शान्त आनन्द के समान काँपता है।",
      "file": "c038.ogg",
      "durationSec": 7.152
    },
    {
      "index": 39,
      "text": "किनारे के एक मोड़ के चारों ओर एक छोटी सी खाड़ी की ओर बढ़ते रहें।",
      "file": "c039.ogg",
      "durationSec": 10.296
    },
    {
      "index": 40,
      "text": "रीड्स फुसफुसाते हैं. पानी लकड़ी पर धीरे से टिकता है।",
      "file": "c040.ogg",
      "durationSec": 9.912
    },
    {
      "index": 41,
      "text": "एक पुरानी गोदी फैली हुई है. आप अंत तक चलें.",
      "file": "c041.ogg",
      "durationSec": 9.312
    },
    {
      "index": 42,
      "text": "ठंडे पानी के ऊपर पैर लटकाकर बैठें।",
      "file": "c042.ogg",
      "durationSec": 6.768
    },
    {
      "index": 43,
      "text": "आपकी पीठ पर सूरज. अपनी पिंडलियों पर हवा का झोंका.",
      "file": "c043.ogg",
      "durationSec": 10.44
    },
    {
      "index": 44,
      "text": "एक पैर का अंगूठा डुबोएं. हल्की ठंडक. एक मुस्कुराहट जिसे आपको दिखाने की ज़रूरत नहीं है।",
      "file": "c044.ogg",
      "durationSec": 17.232
    },
    {
      "index": 45,
      "text": "गर्म तख्तों पर पीठ करके लेट जाएँ।",
      "file": "c045.ogg",
      "durationSec": 6.192
    },
    {
      "index": 46,
      "text": "अपने नीचे पानी सुनो. तुम्हारे ऊपर आकाश.",
      "file": "c046.ogg",
      "durationSec": 9.288
    },
    {
      "index": 47,
      "text": "आपकी सांसें झील की तरह चौड़ी हो जाती हैं।",
      "file": "c047.ogg",
      "durationSec": 7.704
    },
    {
      "index": 48,
      "text": "ताजगी का श्वास लें। अंतहीन नीले रंग में सांस छोड़ें।",
      "file": "c048.ogg",
      "durationSec": 10.2
    },
    {
      "index": 49,
      "text": "हल करने को कुछ नहीं. बस यही गर्मी, यही हवा, यही शांति।",
      "file": "c049.ogg",
      "durationSec": 12.144
    },
    {
      "index": 50,
      "text": "गोदी की गर्मी को अपनी रीढ़ की हड्डी पर महसूस करें।",
      "file": "c050.ogg",
      "durationSec": 8.664
    },
    {
      "index": 51,
      "text": "जब भी हवा का रुख बदल जाए तो हवा की ठंडी रिबन महसूस करें।",
      "file": "c051.ogg",
      "durationSec": 9.816
    },
    {
      "index": 52,
      "text": "एक ड्रैगनफ़्लाई हवा को सींचती है और चली जाती है।",
      "file": "c052.ogg",
      "durationSec": 8.04
    },
    {
      "index": 53,
      "text": "तब तक रुकें जब तक भावना मांसपेशियों और हड्डियों में न समा जाए।",
      "file": "c053.ogg",
      "durationSec": 10.488
    },
    {
      "index": 54,
      "text": "यदि मन कार्यों को सूचीबद्ध करता है, तो उन्हें अभी के लिए दूर किनारे पर सेट करें।",
      "file": "c054.ogg",
      "durationSec": 12.288
    },
    {
      "index": 55,
      "text": "वे इंतजार कर सकते हैं. झील किसी चीज़ का इंतज़ार नहीं कर रही है।",
      "file": "c055.ogg",
      "durationSec": 11.184
    },
    {
      "index": 56,
      "text": "एक हाथ पेट पर. उठना। गिरना।",
      "file": "c056.ogg",
      "durationSec": 9.168
    },
    {
      "index": 57,
      "text": "लकड़ी पर दूसरे हाथ की हथेली के नीचे की गर्माहट।",
      "file": "c057.ogg",
      "durationSec": 8.496
    },
    {
      "index": 58,
      "text": "इस दोहरी पकड़ में आराम करो - शरीर और स्थान।",
      "file": "c058.ogg",
      "durationSec": 7.776
    },
    {
      "index": 59,
      "text": "खड़े हो जाओ और कल्पना में थोड़ा आगे चलो।",
      "file": "c059.ogg",
      "durationSec": 7.176
    },
    {
      "index": 60,
      "text": "कंकड़ धीरे से क्लिक करते हैं। गिरी हुई शाखा के पास पानी चमक उठता है।",
      "file": "c060.ogg",
      "durationSec": 12.168
    },
    {
      "index": 61,
      "text": "सूरज आपकी गर्दन के पिछले हिस्से को अनुकूल गर्मी से भर देता है।",
      "file": "c061.ogg",
      "durationSec": 9.744
    },
    {
      "index": 62,
      "text": "विलो की छाया कुछ चरणों के लिए आपकी पलकों को ठंडा कर देती है।",
      "file": "c062.ogg",
      "durationSec": 9.264
    },
    {
      "index": 63,
      "text": "बारी-बारी से गर्माहट और ताजगी एक चलती-फिरती प्रार्थना बन जाती है।",
      "file": "c063.ogg",
      "durationSec": 10.392
    },
    {
      "index": 64,
      "text": "किसी शब्द की आवश्यकता नहीं. केवल अनुभूति और श्वास।",
      "file": "c064.ogg",
      "durationSec": 10.776
    },
    {
      "index": 65,
      "text": "गर्म रेत का एक टुकड़ा ढूंढें और खुले पानी की ओर मुंह करके बैठें।",
      "file": "c065.ogg",
      "durationSec": 10.584
    },
    {
      "index": 66,
      "text": "क्षितिज रेखा पर दृष्टि को कोमल होने दें।",
      "file": "c066.ogg",
      "durationSec": 6.84
    },
    {
      "index": 67,
      "text": "झील की ठंडी सुगंध लें।",
      "file": "c067.ogg",
      "durationSec": 5.136
    },
    {
      "index": 68,
      "text": "दूर की पहाड़ियों की ओर सांस छोड़ें।",
      "file": "c068.ogg",
      "durationSec": 6.192
    },
    {
      "index": 69,
      "text": "आप यहां जो कुछ भी लेकर आए हैं वह आपके बगल में किनारे पर आराम कर सकता है।",
      "file": "c069.ogg",
      "durationSec": 11.016
    },
    {
      "index": 70,
      "text": "इसे पानी में ले जाने की जरूरत नहीं है.",
      "file": "c070.ogg",
      "durationSec": 6.552
    },
    {
      "index": 71,
      "text": "तब तक रुकें जब तक अगली तीन सांसें अपने आप पूरी न हो जाएं।",
      "file": "c071.ogg",
      "durationSec": 11.28
    },
    {
      "index": 72,
      "text": "अब कहानी को विराम दीजिए और सनसनी पर कायम रहिए।",
      "file": "c072.ogg",
      "durationSec": 8.16
    },
    {
      "index": 73,
      "text": "इस जगह की ताजगी का आनंद लें।",
      "file": "c073.ogg",
      "durationSec": 5.76
    },
    {
      "index": 74,
      "text": "इसकी गर्माहट और शांति में सांस छोड़ें।",
      "file": "c074.ogg",
      "durationSec": 6.648
    },
    {
      "index": 75,
      "text": "श्वास लें.",
      "file": "c075.ogg",
      "durationSec": 3.168
    },
    {
      "index": 76,
      "text": "साँस छोड़ें।",
      "file": "c076.ogg",
      "durationSec": 3.672
    },
    {
      "index": 77,
      "text": "दोबारा। नरम श्वास.",
      "file": "c077.ogg",
      "durationSec": 6.744
    },
    {
      "index": 78,
      "text": "लंबी सांस छोड़ें.",
      "file": "c078.ogg",
      "durationSec": 4.248
    },
    {
      "index": 79,
      "text": "इस कल्पित संसार की ज़मीन से चिपके हुए शरीर को महसूस करें।",
      "file": "c079.ogg",
      "durationSec": 9.6
    },
    {
      "index": 80,
      "text": "श्वास लें.",
      "file": "c080.ogg",
      "durationSec": 3.168
    },
    {
      "index": 81,
      "text": "साँस छोड़ें।",
      "file": "c081.ogg",
      "durationSec": 3.672
    },
    {
      "index": 82,
      "text": "यदि विचार भटकते हैं, तो त्वचा पर गर्माहट लौटाएँ।",
      "file": "c082.ogg",
      "durationSec": 8.784
    },
    {
      "index": 83,
      "text": "या नाक पर हवा को ठंडा करने के लिए.",
      "file": "c083.ogg",
      "durationSec": 6.336
    },
    {
      "index": 84,
      "text": "श्वास लें.",
      "file": "c084.ogg",
      "durationSec": 3.168
    },
    {
      "index": 85,
      "text": "साँस छोड़ें।",
      "file": "c085.ogg",
      "durationSec": 3.672
    },
    {
      "index": 86,
      "text": "श्वास लें.",
      "file": "c086.ogg",
      "durationSec": 3.168
    },
    {
      "index": 87,
      "text": "साँस छोड़ें।",
      "file": "c087.ogg",
      "durationSec": 3.672
    },
    {
      "index": 88,
      "text": "रहना। नरम करना. जारी रखना।",
      "file": "c088.ogg",
      "durationSec": 9.24
    },
    {
      "index": 89,
      "text": "श्वास लें.",
      "file": "c089.ogg",
      "durationSec": 3.168
    },
    {
      "index": 90,
      "text": "साँस छोड़ें।",
      "file": "c090.ogg",
      "durationSec": 3.672
    },
    {
      "index": 91,
      "text": "एक और आसान चक्र.",
      "file": "c091.ogg",
      "durationSec": 4.488
    },
    {
      "index": 92,
      "text": "श्वास लें.",
      "file": "c092.ogg",
      "durationSec": 3.168
    },
    {
      "index": 93,
      "text": "साँस छोड़ें।",
      "file": "c093.ogg",
      "durationSec": 3.672
    },
    {
      "index": 94,
      "text": "कुछ और सांसों के लिए इस भावना में बने रहें।",
      "file": "c094.ogg",
      "durationSec": 6.768
    },
    {
      "index": 95,
      "text": "गर्मी। कोमलता. पर्याप्तता.",
      "file": "c095.ogg",
      "durationSec": 8.88
    },
    {
      "index": 96,
      "text": "जब भी आपको आवश्यकता हो आप इस स्थान पर वापस आ सकते हैं।",
      "file": "c096.ogg",
      "durationSec": 9.216
    },
    {
      "index": 97,
      "text": "यह केवल कल्पना में नहीं बल्कि आपके ध्यान में रहता है।",
      "file": "c097.ogg",
      "durationSec": 8.304
    },
    {
      "index": 98,
      "text": "श्वास को गहरा करना शुरू करें।",
      "file": "c098.ogg",
      "durationSec": 5.592
    },
    {
      "index": 99,
      "text": "अपने आस-पास के कमरे को फिर से महसूस करें।",
      "file": "c099.ogg",
      "durationSec": 7.632
    },
    {
      "index": 100,
      "text": "उँगलियाँ हिलाओ. पैर की उंगलियों को नरम करें.",
      "file": "c100.ogg",
      "durationSec": 9.216
    },
    {
      "index": 101,
      "text": "जब आप तैयार हों तो अपनी आँखें खोलें।",
      "file": "c101.ogg",
      "durationSec": 6.96
    },
    {
      "index": 102,
      "text": "एक और आसान साँस लें.",
      "file": "c102.ogg",
      "durationSec": 5.088
    },
    {
      "index": 103,
      "text": "आगे जो भी आए उसमें इस शांति को बनाए रखें।",
      "file": "c103.ogg",
      "durationSec": 7.728
    }
  ]
}
