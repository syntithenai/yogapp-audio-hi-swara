  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 159,
  "chunks": [
    {
      "index": 0,
      "text": "स्थिर मुद्रा में स्थिर हो जाएं।",
      "file": "c000.ogg",
      "durationSec": 5.64
    },
    {
      "index": 1,
      "text": "रीढ़ की हड्डी लम्बी लेकिन कठोर नहीं.",
      "file": "c001.ogg",
      "durationSec": 6.768
    },
    {
      "index": 2,
      "text": "श्वास पर ध्यान वैसे ही लाएँ जैसे वह पहले से ही है।",
      "file": "c002.ogg",
      "durationSec": 8.184
    },
    {
      "index": 3,
      "text": "इसे अभी न बदलें. अभी देखो।",
      "file": "c003.ogg",
      "durationSec": 7.368
    },
    {
      "index": 4,
      "text": "नासिका छिद्रों में श्वास की ठंडक महसूस करें।",
      "file": "c004.ogg",
      "durationSec": 7.92
    },
    {
      "index": 5,
      "text": "साँस छोड़ते की गर्माहट को महसूस करें।",
      "file": "c005.ogg",
      "durationSec": 7.128
    },
    {
      "index": 6,
      "text": "या फिर पेट के बढ़ने और घटने पर ध्यान दें।",
      "file": "c006.ogg",
      "durationSec": 7.008
    },
    {
      "index": 7,
      "text": "अपना ध्यान आराम करने के लिए एक जगह चुनें।",
      "file": "c007.ogg",
      "durationSec": 6.936
    },
    {
      "index": 8,
      "text": "जब मन भटक जाए तो कृपया लौट आएं।",
      "file": "c008.ogg",
      "durationSec": 6.432
    },
    {
      "index": 9,
      "text": "कोई निर्णय नहीं. बस वापस आ जाओ.",
      "file": "c009.ogg",
      "durationSec": 8.208
    },
    {
      "index": 10,
      "text": "अब, यदि यह आसान लगता है, तो नरम चक्रों की गिनती करें।",
      "file": "c010.ogg",
      "durationSec": 9.936
    },
    {
      "index": 11,
      "text": "श्वास लें. एक।",
      "file": "c011.ogg",
      "durationSec": 5.616
    },
    {
      "index": 12,
      "text": "साँस छोड़ें। एक।",
      "file": "c012.ogg",
      "durationSec": 6.12
    },
    {
      "index": 13,
      "text": "श्वास लें. दो।",
      "file": "c013.ogg",
      "durationSec": 5.592
    },
    {
      "index": 14,
      "text": "साँस छोड़ें। दो।",
      "file": "c014.ogg",
      "durationSec": 6.072
    },
    {
      "index": 15,
      "text": "पाँच तक जारी रखें, फिर एक बजे से दोबारा शुरू करें।",
      "file": "c015.ogg",
      "durationSec": 9.672
    },
    {
      "index": 16,
      "text": "यदि आप गिनती खो देते हैं, तो दयालुता से शुरुआत करें।",
      "file": "c016.ogg",
      "durationSec": 9.456
    },
    {
      "index": 17,
      "text": "लौटना ही अभ्यास है.",
      "file": "c017.ogg",
      "durationSec": 4.464
    },
    {
      "index": 18,
      "text": "श्वास को स्वाभाविक रहने दो। कोई तनाव नहीं.",
      "file": "c018.ogg",
      "durationSec": 9.24
    },
    {
      "index": 19,
      "text": "मौन में कुछ और चक्र।",
      "file": "c019.ogg",
      "durationSec": 4.44
    },
    {
      "index": 20,
      "text": "गिनती जारी करें.",
      "file": "c020.ogg",
      "durationSec": 4.032
    },
    {
      "index": 21,
      "text": "एक पल के लिए खुली जागरूकता में आराम करें।",
      "file": "c021.ogg",
      "durationSec": 7.224
    },
    {
      "index": 22,
      "text": "तैयार होने पर अपनी आँखें खोलें।",
      "file": "c022.ogg",
      "durationSec": 5.904
    }
  ]
}
