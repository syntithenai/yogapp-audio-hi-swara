  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट ढूंढें, या यदि बेहतर लगे तो लेट जाएं।",
      "file": "c001.ogg",
      "durationSec": 10.368
    },
    {
      "index": 2,
      "text": "हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.272
    },
    {
      "index": 3,
      "text": "आँखें नरम करें, या उन्हें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 6.768
    },
    {
      "index": 4,
      "text": "धीरे-धीरे सांस अंदर लें.",
      "file": "c004.ogg",
      "durationSec": 5.16
    },
    {
      "index": 5,
      "text": "और एक लंबी सांस छोड़ें.",
      "file": "c005.ogg",
      "durationSec": 5.088
    },
    {
      "index": 6,
      "text": "यदि आप चाहें तो अपना एक हाथ पेट के निचले हिस्से पर रखें।",
      "file": "c006.ogg",
      "durationSec": 10.248
    },
    {
      "index": 7,
      "text": "ध्यान दें कि क्या पेट पकड़ रहा है।",
      "file": "c007.ogg",
      "durationSec": 5.952
    },
    {
      "index": 8,
      "text": "[विराम:20]",
      "file": "c008.ogg",
      "durationSec": 4.248
    },
    {
      "index": 9,
      "text": "अगली सांस लेते समय पेट को फैलने दें।",
      "file": "c009.ogg",
      "durationSec": 6.864
    },
    {
      "index": 10,
      "text": "सांस छोड़ते हुए इसे बिना निचोड़े गिरने दें।",
      "file": "c010.ogg",
      "durationSec": 7.2
    },
    {
      "index": 11,
      "text": "[विराम:20]",
      "file": "c011.ogg",
      "durationSec": 4.248
    },
    {
      "index": 12,
      "text": "दोबारा। नरम पेट अंदर.",
      "file": "c012.ogg",
      "durationSec": 6.864
    },
    {
      "index": 13,
      "text": "नरम पेट बाहर.",
      "file": "c013.ogg",
      "durationSec": 4.08
    },
    {
      "index": 14,
      "text": "[विराम:25]",
      "file": "c014.ogg",
      "durationSec": 4.8
    },
    {
      "index": 15,
      "text": "यदि मन बहस करता है, तो शरीर को नेतृत्व करने दें।",
      "file": "c015.ogg",
      "durationSec": 8.592
    },
    {
      "index": 16,
      "text": "विस्तार। मुक्त करना।",
      "file": "c016.ogg",
      "durationSec": 6.144
    },
    {
      "index": 17,
      "text": "[विराम:29]",
      "file": "c017.ogg",
      "durationSec": 4.368
    },
    {
      "index": 18,
      "text": "कंधे झुक जाते हैं.",
      "file": "c018.ogg",
      "durationSec": 3.984
    },
    {
      "index": 19,
      "text": "जबड़ा मुलायम.",
      "file": "c019.ogg",
      "durationSec": 3.744
    },
    {
      "index": 20,
      "text": "पेट मुक्त.",
      "file": "c020.ogg",
      "durationSec": 3.192
    },
    {
      "index": 21,
      "text": "[विराम:25]",
      "file": "c021.ogg",
      "durationSec": 4.8
    },
    {
      "index": 22,
      "text": "दस शांत नरम पेट वाली सांसों के साथ रहें।",
      "file": "c022.ogg",
      "durationSec": 7.272
    },
    {
      "index": 23,
      "text": "[विराम:45]",
      "file": "c023.ogg",
      "durationSec": 5.04
    },
    {
      "index": 24,
      "text": "आने वाली किसी भी सहजता पर ध्यान दें।",
      "file": "c024.ogg",
      "durationSec": 6.336
    },
    {
      "index": 25,
      "text": "[विराम:20]",
      "file": "c025.ogg",
      "durationSec": 4.248
    },
    {
      "index": 26,
      "text": "यहीं आराम करो.",
      "file": "c026.ogg",
      "durationSec": 3.792
    },
    {
      "index": 27,
      "text": "[विराम:27]",
      "file": "c027.ogg",
      "durationSec": 4.776
    },
    {
      "index": 28,
      "text": "एक और आसान साँस लें.",
      "file": "c028.ogg",
      "durationSec": 5.088
    },
    {
      "index": 29,
      "text": "उँगलियाँ हिलाओ.",
      "file": "c029.ogg",
      "durationSec": 3.864
    },
    {
      "index": 30,
      "text": "जब आप तैयार हों तो आँखें खोलें।",
      "file": "c030.ogg",
      "durationSec": 6.216
    },
    {
      "index": 31,
      "text": "इसमें से थोड़ा सा अपने साथ ले जाओ.",
      "file": "c031.ogg",
      "durationSec": 6.504
    }
  ]
}
