{
  "id": "forest-clearing-5",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 445,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट लें, या यदि बेहतर लगे तो लेट जाएँ।",
      "file": "c001.ogg",
      "durationSec": 9.432
    },
    {
      "index": 2,
      "text": "अपने हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.824
    },
    {
      "index": 3,
      "text": "अपनी आँखों को बंद होने दें, या अपनी निगाहें नरम कर लें।",
      "file": "c003.ogg",
      "durationSec": 8.928
    },
    {
      "index": 4,
      "text": "अपने शरीर के भार पर ध्यान दें।",
      "file": "c004.ogg",
      "durationSec": 5.616
    },
    {
      "index": 5,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c005.ogg",
      "durationSec": 6.048
    },
    {
      "index": 6,
      "text": "और लंबी, आसान साँस छोड़ना।",
      "file": "c006.ogg",
      "durationSec": 6.264
    },
    {
      "index": 7,
      "text": "दोबारा। नरम श्वास.",
      "file": "c007.ogg",
      "durationSec": 6.744
    },
    {
      "index": 8,
      "text": "धीरे से साँस छोड़ें.",
      "file": "c008.ogg",
      "durationSec": 4.728
    },
    {
      "index": 9,
      "text": "यदि विचार भटकते हैं तो यह ठीक है। श्वास पर लौटें।",
      "file": "c009.ogg",
      "durationSec": 11.016
    },
    {
      "index": 10,
      "text": "अब, मुलायम पत्तों के कूड़े के नीचे एक पथ की कल्पना करें।",
      "file": "c010.ogg",
      "durationSec": 9.624
    },
    {
      "index": 11,
      "text": "तुम बिना किसी जल्दबाजी के एक शांत जंगल में चले जाओ।",
      "file": "c011.ogg",
      "durationSec": 8.808
    },
    {
      "index": 12,
      "text": "डूबी हुई रोशनी आपके अग्रबाहुओं पर घूमती है।",
      "file": "c012.ogg",
      "durationSec": 7.728
    },
    {
      "index": 13,
      "text": "जहाँ भी त्वचा मिले, सूरज की हल्की गर्माहट को महसूस करें।",
      "file": "c013.ogg",
      "durationSec": 9.888
    },
    {
      "index": 14,
      "text": "पेड़ों के बीच हवा में एक ठंडी ताज़गी दौड़ती है।",
      "file": "c014.ogg",
      "durationSec": 7.704
    },
    {
      "index": 15,
      "text": "हरी धरती, छाल और स्वच्छ खनिज नमी की गंध महसूस करें।",
      "file": "c015.ogg",
      "durationSec": 9.696
    },
    {
      "index": 16,
      "text": "रास्ता एक छोटे से समाशोधन में खुलता है।",
      "file": "c016.ogg",
      "durationSec": 6.984
    },
    {
      "index": 17,
      "text": "काई गिरे हुए लट्ठे को गद्देदार बना देती है। तुम बैठो.",
      "file": "c017.ogg",
      "durationSec": 10.128
    },
    {
      "index": 18,
      "text": "केंद्र में सूर्य का प्रकाश शांत सोने जैसा है।",
      "file": "c018.ogg",
      "durationSec": 6.936
    },
    {
      "index": 19,
      "text": "अपने चेहरे पर उस गर्माहट को महसूस करें, धीमी और दयालु।",
      "file": "c019.ogg",
      "durationSec": 9.864
    },
    {
      "index": 20,
      "text": "एक हवा आपके बालों को छूती है और आपके कनपटियों को ठंडा करती है।",
      "file": "c020.ogg",
      "durationSec": 10.176
    },
    {
      "index": 21,
      "text": "पक्षियों का गीत दूर से आता है, फिर लुप्त हो जाता है।",
      "file": "c021.ogg",
      "durationSec": 8.52
    },
    {
      "index": 22,
      "text": "तुम्हारी साँसें पत्तों की झनझनाहट से मेल खाती हैं।",
      "file": "c022.ogg",
      "durationSec": 7.896
    },
    {
      "index": 23,
      "text": "ताजगी का अनुभव करें. बची हुई जल्दबाजी को बाहर निकालें।",
      "file": "c023.ogg",
      "durationSec": 11.304
    },
    {
      "index": 24,
      "text": "ध्यान दें कि आपके नीचे ज़मीन कितनी सुरक्षित महसूस होती है।",
      "file": "c024.ogg",
      "durationSec": 9.528
    },
    {
      "index": 25,
      "text": "छत्र के ऊपर आकाश कितना विस्तृत प्रतीत होता है।",
      "file": "c025.ogg",
      "durationSec": 7.8
    },
    {
      "index": 26,
      "text": "एक भृंग बिना किसी हड़बड़ी के छाल के धूप से प्रकाशित हिस्से को पार कर जाता है।",
      "file": "c026.ogg",
      "durationSec": 11.088
    },
    {
      "index": 27,
      "text": "आपका यहीं रहने के अलावा कोई ठिकाना नहीं है।",
      "file": "c027.ogg",
      "durationSec": 7.344
    },
    {
      "index": 28,
      "text": "आपकी बंद पलकों पर फिर से गर्माहट आ गई है।",
      "file": "c028.ogg",
      "durationSec": 7.08
    },
    {
      "index": 29,
      "text": "ठंडी हवा आपके कॉलर के नीचे एक दयालु हाथ की तरह फिसलती है।",
      "file": "c029.ogg",
      "durationSec": 9.864
    },
    {
      "index": 30,
      "text": "अपने गालों पर गर्माहट बनाए रखें।",
      "file": "c030.ogg",
      "durationSec": 6.0
    },
    {
      "index": 31,
      "text": "सांस छोड़ते समय अपने होठों पर ठंडी हवा रखें।",
      "file": "c031.ogg",
      "durationSec": 8.064
    },
    {
      "index": 32,
      "text": "यह समाशोधन कुछ नहीं पूछता. यह बस आपको पकड़कर रखता है।",
      "file": "c032.ogg",
      "durationSec": 11.04
    },
    {
      "index": 33,
      "text": "एक और सांस को पेट तक जाने दें।",
      "file": "c033.ogg",
      "durationSec": 5.88
    },
    {
      "index": 34,
      "text": "और फिर से छोड़ दो, पत्तों की तरह मुलायम।",
      "file": "c034.ogg",
      "durationSec": 7.32
    },
    {
      "index": 35,
      "text": "अपना ध्यान धीरे-धीरे समाशोधन के किनारे पर घुमाएँ।",
      "file": "c035.ogg",
      "durationSec": 8.28
    },
    {
      "index": 36,
      "text": "फ़र्न. छाया। स्टंप के आधार पर एक पीला मशरूम।",
      "file": "c036.ogg",
      "durationSec": 10.176
    },
    {
      "index": 37,
      "text": "सब कुछ जीवंत है क्योंकि आप जल्दबाजी नहीं कर रहे हैं।",
      "file": "c037.ogg",
      "durationSec": 8.544
    },
    {
      "index": 38,
      "text": "जहां यह घुटने पर पड़ता है वहां फिर से धूप-गर्मी महसूस करें।",
      "file": "c038.ogg",
      "durationSec": 9.624
    },
    {
      "index": 39,
      "text": "हवा-ठंडक महसूस करें जहां यह गले से होकर गुजरती है।",
      "file": "c039.ogg",
      "durationSec": 9.336
    },
    {
      "index": 40,
      "text": "आप पूरी दोपहर यहां रह सकते हैं। अभी के लिए, कुछ साँसें ही काफी हैं।",
      "file": "c040.ogg",
      "durationSec": 12.024
    },
    {
      "index": 41,
      "text": "अब थोड़ी देर के लिए अकेले सांसों पर आराम करें।",
      "file": "c041.ogg",
      "durationSec": 8.112
    },
    {
      "index": 42,
      "text": "धीरे-धीरे श्वास लें।",
      "file": "c042.ogg",
      "durationSec": 4.416
    },
    {
      "index": 43,
      "text": "धीरे-धीरे सांस छोड़ें।",
      "file": "c043.ogg",
      "durationSec": 4.896
    },
    {
      "index": 44,
      "text": "श्वास लें.",
      "file": "c044.ogg",
      "durationSec": 3.168
    },
    {
      "index": 45,
      "text": "साँस छोड़ें।",
      "file": "c045.ogg",
      "durationSec": 3.672
    },
    {
      "index": 46,
      "text": "जहां भी शरीर गर्म हो वहां गर्माहट महसूस करें।",
      "file": "c046.ogg",
      "durationSec": 7.8
    },
    {
      "index": 47,
      "text": "जहां भी हवा ठंडी हो वहां ठंडक महसूस करें।",
      "file": "c047.ogg",
      "durationSec": 7.944
    },
    {
      "index": 48,
      "text": "श्वास लें.",
      "file": "c048.ogg",
      "durationSec": 3.168
    },
    {
      "index": 49,
      "text": "साँस छोड़ें।",
      "file": "c049.ogg",
      "durationSec": 3.672
    },
    {
      "index": 50,
      "text": "कहीं भी नहीं जाना। ठीक करने के लिए कुछ भी नहीं.",
      "file": "c050.ogg",
      "durationSec": 9.0
    },
    {
      "index": 51,
      "text": "श्वास लें.",
      "file": "c051.ogg",
      "durationSec": 3.168
    },
    {
      "index": 52,
      "text": "साँस छोड़ें।",
      "file": "c052.ogg",
      "durationSec": 3.672
    },
    {
      "index": 53,
      "text": "कुछ शांत सांसों के लिए यहां आराम करें।",
      "file": "c053.ogg",
      "durationSec": 6.672
    },
    {
      "index": 54,
      "text": "जान लें कि आप इस जगह पर कभी भी लौट सकते हैं।",
      "file": "c054.ogg",
      "durationSec": 8.544
    },
    {
      "index": 55,
      "text": "जब आप तैयार हों तो सांस को गहरा करें।",
      "file": "c055.ogg",
      "durationSec": 6.984
    },
    {
      "index": 56,
      "text": "उँगलियाँ और पैर की उँगलियाँ हिलाएँ।",
      "file": "c056.ogg",
      "durationSec": 6.024
    },
    {
      "index": 57,
      "text": "अपनी आँखें धीरे से खोलें.",
      "file": "c057.ogg",
      "durationSec": 5.76
    },
    {
      "index": 58,
      "text": "इस शांति का थोड़ा हिस्सा अपने साथ रखें।",
      "file": "c058.ogg",
      "durationSec": 7.128
    }
  ]
}
