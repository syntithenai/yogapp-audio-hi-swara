{
  "id": "garden-dusk-5",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 412,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट लें, या यदि बेहतर लगे तो लेट जाएँ।",
      "file": "c001.ogg",
      "durationSec": 9.432
    },
    {
      "index": 2,
      "text": "अपने हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.824
    },
    {
      "index": 3,
      "text": "अपनी आँखों को बंद होने दें, या अपनी निगाहें नरम कर लें।",
      "file": "c003.ogg",
      "durationSec": 8.928
    },
    {
      "index": 4,
      "text": "अपने शरीर के भार पर ध्यान दें।",
      "file": "c004.ogg",
      "durationSec": 5.616
    },
    {
      "index": 5,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c005.ogg",
      "durationSec": 6.048
    },
    {
      "index": 6,
      "text": "और लंबी, आसान साँस छोड़ना।",
      "file": "c006.ogg",
      "durationSec": 6.264
    },
    {
      "index": 7,
      "text": "दोबारा। नरम श्वास.",
      "file": "c007.ogg",
      "durationSec": 6.744
    },
    {
      "index": 8,
      "text": "धीरे से साँस छोड़ें.",
      "file": "c008.ogg",
      "durationSec": 4.728
    },
    {
      "index": 9,
      "text": "यदि विचार भटकते हैं तो यह ठीक है। श्वास पर लौटें।",
      "file": "c009.ogg",
      "durationSec": 11.016
    },
    {
      "index": 10,
      "text": "नरम शाम के समय एक शांत दीवारों वाले बगीचे की कल्पना करें।",
      "file": "c010.ogg",
      "durationSec": 9.744
    },
    {
      "index": 11,
      "text": "पत्थर के रास्ते दिन की आखिरी गर्माहट बरकरार रखते हैं।",
      "file": "c011.ogg",
      "durationSec": 8.568
    },
    {
      "index": 12,
      "text": "अपने पैरों के तलवों के माध्यम से उस हल्की गर्मी को महसूस करें।",
      "file": "c012.ogg",
      "durationSec": 9.624
    },
    {
      "index": 13,
      "text": "लैवेंडर और शाम के गुलाब एक शांत सुगंध छोड़ते हैं।",
      "file": "c013.ogg",
      "durationSec": 8.136
    },
    {
      "index": 14,
      "text": "दीवार पर ठंडी हवा चलती है और आपकी गर्दन को ठंडक पहुँचाती है।",
      "file": "c014.ogg",
      "durationSec": 10.272
    },
    {
      "index": 15,
      "text": "गर्म दोपहर के बाद हवा ताज़ा है।",
      "file": "c015.ogg",
      "durationSec": 5.904
    },
    {
      "index": 16,
      "text": "आप सांसों की तरह मुलायम छंटे हुए बाड़ों के बीच धीरे-धीरे चलते हैं।",
      "file": "c016.ogg",
      "durationSec": 10.296
    },
    {
      "index": 17,
      "text": "आपकी उंगलियाँ अभी भी सूरज को थामे हुए पत्तों को ब्रश करती हैं।",
      "file": "c017.ogg",
      "durationSec": 9.216
    },
    {
      "index": 18,
      "text": "गरम। चिकना। जीवित।",
      "file": "c018.ogg",
      "durationSec": 8.712
    },
    {
      "index": 19,
      "text": "एक शांत पेड़ के नीचे एक लकड़ी की बेंच इंतज़ार कर रही है।",
      "file": "c019.ogg",
      "durationSec": 8.928
    },
    {
      "index": 20,
      "text": "तुम बैठो. लकड़ी आपकी पीठ पर सुखद रूप से गर्म होती है।",
      "file": "c020.ogg",
      "durationSec": 10.776
    },
    {
      "index": 21,
      "text": "ऊपर, आकाश लैवेंडर और गुलाबी हो जाता है।",
      "file": "c021.ogg",
      "durationSec": 7.536
    },
    {
      "index": 22,
      "text": "पक्षी बसते हैं। बगीचा शांत हो जाता है।",
      "file": "c022.ogg",
      "durationSec": 8.592
    },
    {
      "index": 23,
      "text": "पत्थर और लकड़ी से गर्माहट कम होती हुई महसूस करें।",
      "file": "c023.ogg",
      "durationSec": 8.616
    },
    {
      "index": 24,
      "text": "शाम की ताज़ा ठंडक को अपने चेहरे पर महसूस करें।",
      "file": "c024.ogg",
      "durationSec": 8.472
    },
    {
      "index": 25,
      "text": "गंध और शांति को अंदर लें।",
      "file": "c025.ogg",
      "durationSec": 5.376
    },
    {
      "index": 26,
      "text": "जिस दिन आपने सांस अंदर ली थी उसी दिन सांस छोड़ें।",
      "file": "c026.ogg",
      "durationSec": 8.808
    },
    {
      "index": 27,
      "text": "एक पतंगा आखिरी सुनहरी रोशनी से होकर गुजरता है।",
      "file": "c027.ogg",
      "durationSec": 8.136
    },
    {
      "index": 28,
      "text": "यहां कुछ भी अत्यावश्यक नहीं है. सब कुछ काफी है.",
      "file": "c028.ogg",
      "durationSec": 9.816
    },
    {
      "index": 29,
      "text": "उस पर्याप्तता में आराम करो.",
      "file": "c029.ogg",
      "durationSec": 5.28
    },
    {
      "index": 30,
      "text": "अपने पेट को शाम की हवा में नरम होने दें।",
      "file": "c030.ogg",
      "durationSec": 6.768
    },
    {
      "index": 31,
      "text": "अपनी अगली सांस को दिन की सबसे शांत सांस होने दें।",
      "file": "c031.ogg",
      "durationSec": 8.496
    },
    {
      "index": 32,
      "text": "काम पूरा करने से पहले रास्ते का एक धीमा चक्कर लगाएँ।",
      "file": "c032.ogg",
      "durationSec": 8.688
    },
    {
      "index": 33,
      "text": "गर्म पत्थर पैरों के नीचे ठंडे हो रहे हैं।",
      "file": "c033.ogg",
      "durationSec": 6.96
    },
    {
      "index": 34,
      "text": "हेजेज दिन भर का संग्रहित इत्र जारी कर रहे हैं।",
      "file": "c034.ogg",
      "durationSec": 7.344
    },
    {
      "index": 35,
      "text": "हवा में अब शाम की लहर है - ताज़ी, लगभग मीठी।",
      "file": "c035.ogg",
      "durationSec": 8.496
    },
    {
      "index": 36,
      "text": "गेट को खोले बिना ही रुकें।",
      "file": "c036.ogg",
      "durationSec": 5.208
    },
    {
      "index": 37,
      "text": "महसूस करें कि कंधों में कितनी शांति बस गई है।",
      "file": "c037.ogg",
      "durationSec": 7.944
    },
    {
      "index": 38,
      "text": "बगीचे की शांति को एक छोटे लालटेन की तरह अंदर की ओर ले जाएं।",
      "file": "c038.ogg",
      "durationSec": 10.56
    },
    {
      "index": 39,
      "text": "अब थोड़ी देर के लिए अकेले सांसों पर आराम करें।",
      "file": "c039.ogg",
      "durationSec": 8.112
    },
    {
      "index": 40,
      "text": "धीरे-धीरे श्वास लें।",
      "file": "c040.ogg",
      "durationSec": 4.416
    },
    {
      "index": 41,
      "text": "धीरे-धीरे सांस छोड़ें।",
      "file": "c041.ogg",
      "durationSec": 4.896
    },
    {
      "index": 42,
      "text": "श्वास लें.",
      "file": "c042.ogg",
      "durationSec": 3.168
    },
    {
      "index": 43,
      "text": "साँस छोड़ें।",
      "file": "c043.ogg",
      "durationSec": 3.672
    },
    {
      "index": 44,
      "text": "जहां भी शरीर गर्म हो वहां गर्माहट महसूस करें।",
      "file": "c044.ogg",
      "durationSec": 7.8
    },
    {
      "index": 45,
      "text": "जहां भी हवा ठंडी हो वहां ठंडक महसूस करें।",
      "file": "c045.ogg",
      "durationSec": 7.944
    },
    {
      "index": 46,
      "text": "श्वास लें.",
      "file": "c046.ogg",
      "durationSec": 3.168
    },
    {
      "index": 47,
      "text": "साँस छोड़ें।",
      "file": "c047.ogg",
      "durationSec": 3.672
    },
    {
      "index": 48,
      "text": "कहीं भी नहीं जाना। ठीक करने के लिए कुछ भी नहीं.",
      "file": "c048.ogg",
      "durationSec": 9.0
    },
    {
      "index": 49,
      "text": "श्वास लें.",
      "file": "c049.ogg",
      "durationSec": 3.168
    },
    {
      "index": 50,
      "text": "साँस छोड़ें।",
      "file": "c050.ogg",
      "durationSec": 3.672
    },
    {
      "index": 51,
      "text": "कुछ शांत सांसों के लिए यहां आराम करें।",
      "file": "c051.ogg",
      "durationSec": 6.672
    },
    {
      "index": 52,
      "text": "जान लें कि आप इस जगह पर कभी भी लौट सकते हैं।",
      "file": "c052.ogg",
      "durationSec": 8.544
    },
    {
      "index": 53,
      "text": "जब आप तैयार हों तो सांस को गहरा करें।",
      "file": "c053.ogg",
      "durationSec": 6.984
    },
    {
      "index": 54,
      "text": "उँगलियाँ और पैर की उँगलियाँ हिलाएँ।",
      "file": "c054.ogg",
      "durationSec": 6.024
    },
    {
      "index": 55,
      "text": "अपनी आँखें धीरे से खोलें.",
      "file": "c055.ogg",
      "durationSec": 5.76
    },
    {
      "index": 56,
      "text": "इस शांति का थोड़ा हिस्सा अपने साथ रखें।",
      "file": "c056.ogg",
      "durationSec": 7.128
    }
  ]
}
