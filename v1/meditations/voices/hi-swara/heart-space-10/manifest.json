  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "आने के लिए समय निकालें.",
      "file": "c001.ogg",
      "durationSec": 4.752
    },
    {
      "index": 2,
      "text": "सहारा लेकर बैठें या लेटें।",
      "file": "c002.ogg",
      "durationSec": 5.52
    },
    {
      "index": 3,
      "text": "अगर सुरक्षित महसूस हो तो आंखें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 7.272
    },
    {
      "index": 4,
      "text": "जमीन के साथ संपर्क महसूस करें.",
      "file": "c004.ogg",
      "durationSec": 6.384
    },
    {
      "index": 5,
      "text": "धीमी गति से सांस अंदर लें.",
      "file": "c005.ogg",
      "durationSec": 5.64
    },
    {
      "index": 6,
      "text": "लंबी सांस छोड़ें.",
      "file": "c006.ogg",
      "durationSec": 4.248
    },
    {
      "index": 7,
      "text": "[विराम:25]",
      "file": "c007.ogg",
      "durationSec": 4.8
    },
    {
      "index": 8,
      "text": "दोबारा।",
      "file": "c008.ogg",
      "durationSec": 3.048
    },
    {
      "index": 9,
      "text": "[विराम:25]",
      "file": "c009.ogg",
      "durationSec": 4.8
    },
    {
      "index": 10,
      "text": "कंधों को झुक जाने दो.",
      "file": "c010.ogg",
      "durationSec": 4.512
    },
    {
      "index": 11,
      "text": "पेट को नरम होने दें.",
      "file": "c011.ogg",
      "durationSec": 4.512
    },
    {
      "index": 12,
      "text": "[विराम:31]",
      "file": "c012.ogg",
      "durationSec": 4.536
    },
    {
      "index": 13,
      "text": "ध्यान को छाती के केंद्र पर लाएँ।",
      "file": "c013.ogg",
      "durationSec": 6.024
    },
    {
      "index": 14,
      "text": "जबरदस्ती भावना नहीं. बस जगह का पता लगा रहा हूं.",
      "file": "c014.ogg",
      "durationSec": 10.56
    },
    {
      "index": 15,
      "text": "[विराम:31]",
      "file": "c015.ogg",
      "durationSec": 4.536
    },
    {
      "index": 16,
      "text": "साँस ऐसे लें मानो श्वास हृदय से प्रवेश करती हो।",
      "file": "c016.ogg",
      "durationSec": 8.784
    },
    {
      "index": 17,
      "text": "साँस छोड़ना मानो दिल को अंदर से नरम कर देता है।",
      "file": "c017.ogg",
      "durationSec": 7.896
    },
    {
      "index": 18,
      "text": "[विराम:37]",
      "file": "c018.ogg",
      "durationSec": 4.68
    },
    {
      "index": 19,
      "text": "भावना उठे तो उसे मौसम की तरह चलने दो।",
      "file": "c019.ogg",
      "durationSec": 7.392
    },
    {
      "index": 20,
      "text": "[विराम:37]",
      "file": "c020.ogg",
      "durationSec": 4.68
    },
    {
      "index": 21,
      "text": "चुपचाप: मेरे हृदय को शांति मिले।",
      "file": "c021.ogg",
      "durationSec": 6.84
    },
    {
      "index": 22,
      "text": "[विराम:31]",
      "file": "c022.ogg",
      "durationSec": 4.536
    },
    {
      "index": 23,
      "text": "क्या मैं अपने समय के प्रति धैर्यवान रह सकता हूँ?",
      "file": "c023.ogg",
      "durationSec": 7.416
    },
    {
      "index": 24,
      "text": "[विराम:31]",
      "file": "c024.ogg",
      "durationSec": 4.536
    },
    {
      "index": 25,
      "text": "किसी ऐसे व्यक्ति का ध्यान रखें जिसकी देखभाल करना आसान हो।",
      "file": "c025.ogg",
      "durationSec": 10.488
    },
    {
      "index": 26,
      "text": "उनकी सहजता की कामना करें.",
      "file": "c026.ogg",
      "durationSec": 5.568
    },
    {
      "index": 27,
      "text": "आप निश्चिंत रहें.",
      "file": "c027.ogg",
      "durationSec": 3.912
    },
    {
      "index": 28,
      "text": "[विराम:37]",
      "file": "c028.ogg",
      "durationSec": 4.68
    },
    {
      "index": 29,
      "text": "अपने हृदय स्थान पर लौटें।",
      "file": "c029.ogg",
      "durationSec": 5.208
    },
    {
      "index": 30,
      "text": "गरम। विशाल. इंसान।",
      "file": "c030.ogg",
      "durationSec": 8.448
    },
    {
      "index": 31,
      "text": "[विराम:75]",
      "file": "c031.ogg",
      "durationSec": 4.656
    },
    {
      "index": 32,
      "text": "यहीं आराम करो.",
      "file": "c032.ogg",
      "durationSec": 3.792
    },
    {
      "index": 33,
      "text": "[विराम:90]",
      "file": "c033.ogg",
      "durationSec": 4.104
    },
    {
      "index": 34,
      "text": "[विराम:37]",
      "file": "c034.ogg",
      "durationSec": 4.68
    },
    {
      "index": 35,
      "text": "श्वास को गहरा करना शुरू करें।",
      "file": "c035.ogg",
      "durationSec": 5.592
    },
    {
      "index": 36,
      "text": "कमरे को फिर से महसूस करो.",
      "file": "c036.ogg",
      "durationSec": 5.352
    },
    {
      "index": 37,
      "text": "उँगलियाँ और पैर की उँगलियाँ हिलाएँ।",
      "file": "c037.ogg",
      "durationSec": 6.024
    },
    {
      "index": 38,
      "text": "तैयार होने पर आँखें खोलें।",
      "file": "c038.ogg",
      "durationSec": 5.256
    },
    {
      "index": 39,
      "text": "आगे जो आता है उसमें धीरे-धीरे आगे बढ़ें।",
      "file": "c039.ogg",
      "durationSec": 7.296
    }
