  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 534,
  "chunks": [
    {
      "index": 0,
      "text": "गहन विश्राम के अभ्यास में आपका स्वागत है।",
      "file": "c000.ogg",
      "durationSec": 7.224
    },
    {
      "index": 1,
      "text": "यदि संभव हो तो अपनी पीठ के बल लेटें।",
      "file": "c001.ogg",
      "durationSec": 7.032
    },
    {
      "index": 2,
      "text": "यदि इससे मदद मिले तो सिर और घुटनों को सहारा दें।",
      "file": "c002.ogg",
      "durationSec": 7.944
    },
    {
      "index": 3,
      "text": "भुजाओं को अपने बगल में आराम दें, हथेलियाँ नरम।",
      "file": "c003.ogg",
      "durationSec": 8.28
    },
    {
      "index": 4,
      "text": "आँखें बंद कर लो.",
      "file": "c004.ogg",
      "durationSec": 4.008
    },
    {
      "index": 5,
      "text": "कहीं और होना नहीं है.",
      "file": "c005.ogg",
      "durationSec": 4.752
    },
    {
      "index": 6,
      "text": "[विराम:23]",
      "file": "c006.ogg",
      "durationSec": 4.296
    },
    {
      "index": 7,
      "text": "फर्श या बिस्तर के संपर्क बिंदुओं को महसूस करें।",
      "file": "c007.ogg",
      "durationSec": 7.728
    },
    {
      "index": 8,
      "text": "ऊँची एड़ी के जूते। नितंब। कंधे ब्लेड। सिर।",
      "file": "c008.ogg",
      "durationSec": 12.672
    },
    {
      "index": 9,
      "text": "शरीर को पकड़े रहने दें.",
      "file": "c009.ogg",
      "durationSec": 5.064
    },
    {
      "index": 10,
      "text": "[विराम:23]",
      "file": "c010.ogg",
      "durationSec": 4.296
    },
    {
      "index": 11,
      "text": "प्राकृतिक सांस पर ध्यान दें.",
      "file": "c011.ogg",
      "durationSec": 5.304
    },
    {
      "index": 12,
      "text": "इसे बदलने की कोई जरूरत नहीं है.",
      "file": "c012.ogg",
      "durationSec": 6.168
    },
    {
      "index": 13,
      "text": "श्वास आती है.",
      "file": "c013.ogg",
      "durationSec": 3.576
    },
    {
      "index": 14,
      "text": "साँस छोड़ें पत्तियाँ।",
      "file": "c014.ogg",
      "durationSec": 4.536
    },
    {
      "index": 15,
      "text": "[विराम:25]",
      "file": "c015.ogg",
      "durationSec": 4.8
    },
    {
      "index": 16,
      "text": "यदि मन व्यस्त है, तो इसकी अनुमति है।",
      "file": "c016.ogg",
      "durationSec": 6.888
    },
    {
      "index": 17,
      "text": "आप वैसे भी आराम कर सकते हैं.",
      "file": "c017.ogg",
      "durationSec": 5.664
    },
    {
      "index": 18,
      "text": "बस संवेदना की ओर लौटते रहें।",
      "file": "c018.ogg",
      "durationSec": 5.856
    },
    {
      "index": 19,
      "text": "[विराम:23]",
      "file": "c019.ogg",
      "durationSec": 4.296
    },
    {
      "index": 20,
      "text": "दाहिने पैर में जागरूकता लाओ।",
      "file": "c020.ogg",
      "durationSec": 5.88
    },
    {
      "index": 21,
      "text": "पैर की उँगलियाँ। अकेला। एड़ी.",
      "file": "c021.ogg",
      "durationSec": 8.952
    },
    {
      "index": 22,
      "text": "[विराम:21]",
      "file": "c022.ogg",
      "durationSec": 4.68
    },
    {
      "index": 23,
      "text": "दाहिना निचला पैर.",
      "file": "c023.ogg",
      "durationSec": 4.248
    },
    {
      "index": 24,
      "text": "घुटना।",
      "file": "c024.ogg",
      "durationSec": 2.856
    },
    {
      "index": 25,
      "text": "जाँघ।",
      "file": "c025.ogg",
      "durationSec": 2.784
    },
    {
      "index": 26,
      "text": "[विराम:21]",
      "file": "c026.ogg",
      "durationSec": 4.68
    },
    {
      "index": 27,
      "text": "दाहिना कूल्हा.",
      "file": "c027.ogg",
      "durationSec": 3.672
    },
    {
      "index": 28,
      "text": "पूरा दाहिना पैर, भारी और शांत।",
      "file": "c028.ogg",
      "durationSec": 6.672
    },
    {
      "index": 29,
      "text": "[विराम:23]",
      "file": "c029.ogg",
      "durationSec": 4.296
    },
    {
      "index": 30,
      "text": "बाया पैर।",
      "file": "c030.ogg",
      "durationSec": 3.384
    },
    {
      "index": 31,
      "text": "पैर की उँगलियाँ। अकेला। एड़ी.",
      "file": "c031.ogg",
      "durationSec": 8.952
    },
    {
      "index": 32,
      "text": "[विराम:21]",
      "file": "c032.ogg",
      "durationSec": 4.68
    },
    {
      "index": 33,
      "text": "बायां निचला पैर.",
      "file": "c033.ogg",
      "durationSec": 4.104
    },
    {
      "index": 34,
      "text": "घुटना।",
      "file": "c034.ogg",
      "durationSec": 2.856
    },
    {
      "index": 35,
      "text": "जाँघ।",
      "file": "c035.ogg",
      "durationSec": 2.784
    },
    {
      "index": 36,
      "text": "[विराम:21]",
      "file": "c036.ogg",
      "durationSec": 4.68
    },
    {
      "index": 37,
      "text": "बायां कूल्हा.",
      "file": "c037.ogg",
      "durationSec": 3.624
    },
    {
      "index": 38,
      "text": "पूरा बायां पैर, भारी और शांत।",
      "file": "c038.ogg",
      "durationSec": 6.504
    },
    {
      "index": 39,
      "text": "[विराम:23]",
      "file": "c039.ogg",
      "durationSec": 4.296
    },
    {
      "index": 40,
      "text": "श्रोणि और निचला पेट.",
      "file": "c040.ogg",
      "durationSec": 4.752
    },
    {
      "index": 41,
      "text": "कोमल।",
      "file": "c041.ogg",
      "durationSec": 2.808
    },
    {
      "index": 42,
      "text": "[विराम:21]",
      "file": "c042.ogg",
      "durationSec": 4.68
    },
    {
      "index": 43,
      "text": "छाती का उठना और गिरना।",
      "file": "c043.ogg",
      "durationSec": 5.136
    },
    {
      "index": 44,
      "text": "हृदय स्थान खुला और आसान.",
      "file": "c044.ogg",
      "durationSec": 5.616
    },
    {
      "index": 45,
      "text": "[विराम:23]",
      "file": "c045.ogg",
      "durationSec": 4.296
    },
    {
      "index": 46,
      "text": "दांया हाथ।",
      "file": "c046.ogg",
      "durationSec": 3.576
    },
    {
      "index": 47,
      "text": "उँगलियाँ. हथेली। कलाई।",
      "file": "c047.ogg",
      "durationSec": 8.256
    },
    {
      "index": 48,
      "text": "[विराम:14]",
      "file": "c048.ogg",
      "durationSec": 4.44
    },
    {
      "index": 49,
      "text": "दाहिना हाथ। कोहनी। कंधा।",
      "file": "c049.ogg",
      "durationSec": 8.904
    },
    {
      "index": 50,
      "text": "[विराम:21]",
      "file": "c050.ogg",
      "durationSec": 4.68
    },
    {
      "index": 51,
      "text": "बायां हाथ.",
      "file": "c051.ogg",
      "durationSec": 3.624
    },
    {
      "index": 52,
      "text": "उँगलियाँ. हथेली। कलाई।",
      "file": "c052.ogg",
      "durationSec": 8.256
    },
    {
      "index": 53,
      "text": "[विराम:14]",
      "file": "c053.ogg",
      "durationSec": 4.44
    },
    {
      "index": 54,
      "text": "बांया हाथ। कोहनी। कंधा।",
      "file": "c054.ogg",
      "durationSec": 8.76
    },
    {
      "index": 55,
      "text": "[विराम:23]",
      "file": "c055.ogg",
      "durationSec": 4.296
    },
    {
      "index": 56,
      "text": "गला मुलायम.",
      "file": "c056.ogg",
      "durationSec": 3.528
    },
    {
      "index": 57,
      "text": "जबड़ा अशुद्ध.",
      "file": "c057.ogg",
      "durationSec": 3.624
    },
    {
      "index": 58,
      "text": "जीभ को आराम.",
      "file": "c058.ogg",
      "durationSec": 3.96
    },
    {
      "index": 59,
      "text": "[विराम:21]",
      "file": "c059.ogg",
      "durationSec": 4.68
    },
    {
      "index": 60,
      "text": "आँखें अपनी जेबों में आराम कर रही हैं।",
      "file": "c060.ogg",
      "durationSec": 6.144
    },
    {
      "index": 61,
      "text": "माथा चिकना.",
      "file": "c061.ogg",
      "durationSec": 3.672
    },
    {
      "index": 62,
      "text": "सिर की खोपड़ी और मुकुट.",
      "file": "c062.ogg",
      "durationSec": 5.16
    },
    {
      "index": 63,
      "text": "[विराम:23]",
      "file": "c063.ogg",
      "durationSec": 4.296
    },
    {
      "index": 64,
      "text": "पूरे शरीर को शांति के एक क्षेत्र के रूप में महसूस करें।",
      "file": "c064.ogg",
      "durationSec": 8.976
    },
    {
      "index": 65,
      "text": "इसमें शांत ज्वार की तरह सांसें चल रही हैं।",
      "file": "c065.ogg",
      "durationSec": 7.104
    },
    {
      "index": 66,
      "text": "[विराम:62]",
      "file": "c066.ogg",
      "durationSec": 4.224
    },
    {
      "index": 67,
      "text": "पूरे शरीर के साथ रहें.",
      "file": "c067.ogg",
      "durationSec": 4.872
    },
    {
      "index": 68,
      "text": "[विराम:105]",
      "file": "c068.ogg",
      "durationSec": 5.472
    },
    {
      "index": 69,
      "text": "कोमल। विशाल. फिर भी।",
      "file": "c069.ogg",
      "durationSec": 8.544
    },
    {
      "index": 70,
      "text": "[विराम:55]",
      "file": "c070.ogg",
      "durationSec": 4.32
    },
    {
      "index": 71,
      "text": "यदि कोई विचार आये तो उसे बादल की तरह गुजर जाने दो।",
      "file": "c071.ogg",
      "durationSec": 8.784
    },
    {
      "index": 72,
      "text": "[विराम:50]",
      "file": "c072.ogg",
      "durationSec": 4.44
    },
    {
      "index": 73,
      "text": "पकड़े जाने की भावना पर लौटें।",
      "file": "c073.ogg",
      "durationSec": 5.712
    },
    {
      "index": 74,
      "text": "[विराम:55]",
      "file": "c074.ogg",
      "durationSec": 4.32
    },
    {
      "index": 75,
      "text": "यहीं आराम करो.",
      "file": "c075.ogg",
      "durationSec": 3.792
    },
    {
      "index": 76,
      "text": "हल करने को कुछ नहीं.",
      "file": "c076.ogg",
      "durationSec": 4.512
    },
    {
      "index": 77,
      "text": "पूरा करने के लिए कुछ भी नहीं.",
      "file": "c077.ogg",
      "durationSec": 5.424
    },
    {
      "index": 78,
      "text": "[विराम:110]",
      "file": "c078.ogg",
      "durationSec": 5.472
    },
    {
      "index": 79,
      "text": "यदि आप बहते हैं, तो यह ठीक है।",
      "file": "c079.ogg",
      "durationSec": 6.528
    },
    {
      "index": 80,
      "text": "यदि आप जागरूक रहें तो यह भी ठीक है।",
      "file": "c080.ogg",
      "durationSec": 6.912
    },
    {
      "index": 81,
      "text": "दोनों विश्राम हैं.",
      "file": "c081.ogg",
      "durationSec": 4.056
    },
    {
      "index": 82,
      "text": "[विराम:130]",
      "file": "c082.ogg",
      "durationSec": 5.496
    },
    {
      "index": 83,
      "text": "आराम।",
      "file": "c083.ogg",
      "durationSec": 2.904
    },
    {
      "index": 84,
      "text": "[विराम:115]",
      "file": "c084.ogg",
      "durationSec": 5.4
    },
    {
      "index": 85,
      "text": "सांस पर फिर से ध्यान देना शुरू करें।",
      "file": "c085.ogg",
      "durationSec": 6.696
    },
    {
      "index": 86,
      "text": "अब थोड़ा और उज्ज्वल।",
      "file": "c086.ogg",
      "durationSec": 4.488
    },
    {
      "index": 87,
      "text": "[विराम:23]",
      "file": "c087.ogg",
      "durationSec": 4.296
    },
    {
      "index": 88,
      "text": "अपने आस-पास के कमरे को महसूस करें।",
      "file": "c088.ogg",
      "durationSec": 6.72
    },
    {
      "index": 89,
      "text": "निकट और दूर लगता है.",
      "file": "c089.ogg",
      "durationSec": 4.536
    },
    {
      "index": 90,
      "text": "[विराम:21]",
      "file": "c090.ogg",
      "durationSec": 4.68
    },
    {
      "index": 91,
      "text": "उँगलियाँ हिलाओ.",
      "file": "c091.ogg",
      "durationSec": 3.864
    },
    {
      "index": 92,
      "text": "पैर की उंगलियों को हिलाएं.",
      "file": "c092.ogg",
      "durationSec": 4.968
    },
    {
      "index": 93,
      "text": "यदि आप चाहें तो कलाइयों और टखनों को रोल करें।",
      "file": "c093.ogg",
      "durationSec": 8.16
    },
    {
      "index": 94,
      "text": "[विराम:21]",
      "file": "c094.ogg",
      "durationSec": 4.68
    },
    {
      "index": 95,
      "text": "गहरी सांस अंदर लें.",
      "file": "c095.ogg",
      "durationSec": 4.536
    },
    {
      "index": 96,
      "text": "और एक लंबी आह निकली.",
      "file": "c096.ogg",
      "durationSec": 4.968
    },
    {
      "index": 97,
      "text": "जब आप तैयार हों तो आँखें खोलें।",
      "file": "c097.ogg",
      "durationSec": 6.216
    },
    {
      "index": 98,
      "text": "धीरे-धीरे लौटें.",
      "file": "c098.ogg",
      "durationSec": 4.032
    },
    {
      "index": 99,
      "text": "इस शांति का थोड़ा सा हिस्सा अपने साथ रखें।",
      "file": "c099.ogg",
      "durationSec": 7.56
    }
  ]
