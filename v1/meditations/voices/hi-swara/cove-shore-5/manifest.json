{
  "id": "cove-shore-5",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 436,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "एक आरामदायक सीट लें, या यदि बेहतर लगे तो लेट जाएँ।",
      "file": "c001.ogg",
      "durationSec": 9.432
    },
    {
      "index": 2,
      "text": "अपने हाथों को आराम दें.",
      "file": "c002.ogg",
      "durationSec": 4.824
    },
    {
      "index": 3,
      "text": "अपनी आँखों को बंद होने दें, या अपनी निगाहें नरम कर लें।",
      "file": "c003.ogg",
      "durationSec": 8.928
    },
    {
      "index": 4,
      "text": "अपने शरीर के भार पर ध्यान दें।",
      "file": "c004.ogg",
      "durationSec": 5.616
    },
    {
      "index": 5,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c005.ogg",
      "durationSec": 6.048
    },
    {
      "index": 6,
      "text": "और लंबी, आसान साँस छोड़ना।",
      "file": "c006.ogg",
      "durationSec": 6.264
    },
    {
      "index": 7,
      "text": "दोबारा। नरम श्वास.",
      "file": "c007.ogg",
      "durationSec": 6.744
    },
    {
      "index": 8,
      "text": "धीरे से साँस छोड़ें.",
      "file": "c008.ogg",
      "durationSec": 4.728
    },
    {
      "index": 9,
      "text": "यदि विचार भटकते हैं तो यह ठीक है। श्वास पर लौटें।",
      "file": "c009.ogg",
      "durationSec": 11.016
    },
    {
      "index": 10,
      "text": "अपने आप को एक सुरक्षित खाड़ी में पहुँचते हुए देखें।",
      "file": "c010.ogg",
      "durationSec": 8.376
    },
    {
      "index": 11,
      "text": "चट्टानें नरम पीली रेत के चारों ओर घूमती हैं।",
      "file": "c011.ogg",
      "durationSec": 7.512
    },
    {
      "index": 12,
      "text": "समुद्र धीमी, धैर्यवान लहरों में चलता है।",
      "file": "c012.ogg",
      "durationSec": 7.176
    },
    {
      "index": 13,
      "text": "हल्की धूप आपके कंधों के ऊपरी हिस्से को गर्म कर देती है।",
      "file": "c013.ogg",
      "durationSec": 8.568
    },
    {
      "index": 14,
      "text": "एक नमकीन हवा आपके होठों और पलकों को ठंडक पहुँचाती है।",
      "file": "c014.ogg",
      "durationSec": 9.168
    },
    {
      "index": 15,
      "text": "उस हवा की ताज़गी को अपने सीने में भरते हुए महसूस करें।",
      "file": "c015.ogg",
      "durationSec": 8.784
    },
    {
      "index": 16,
      "text": "जलरेखा तक चलो. गीली रेत आपके पैरों से चिपक जाती है।",
      "file": "c016.ogg",
      "durationSec": 10.896
    },
    {
      "index": 17,
      "text": "ठंडा झाग आपकी एड़ियों को छूता है और फिसल जाता है।",
      "file": "c017.ogg",
      "durationSec": 8.472
    },
    {
      "index": 18,
      "text": "लय सरल है. आना। नरम करना. छुट्टी।",
      "file": "c018.ogg",
      "durationSec": 11.808
    },
    {
      "index": 19,
      "text": "वहां बैठें जहां सूखी रेत आपके नीचे गर्म हो।",
      "file": "c019.ogg",
      "durationSec": 8.136
    },
    {
      "index": 20,
      "text": "अपने हाथों पर पीछे झुकें। दानेदार गर्मी महसूस करें.",
      "file": "c020.ogg",
      "durationSec": 10.512
    },
    {
      "index": 21,
      "text": "खाड़ी की शांति और भीड़ को सुनो।",
      "file": "c021.ogg",
      "durationSec": 6.264
    },
    {
      "index": 22,
      "text": "नमक, धूप और साफ पत्थर को सूंघें।",
      "file": "c022.ogg",
      "durationSec": 7.512
    },
    {
      "index": 23,
      "text": "आपकी त्वचा पर गर्माहट. हर साँस में शीतलता.",
      "file": "c023.ogg",
      "durationSec": 9.408
    },
    {
      "index": 24,
      "text": "दूर तक, रोशनी शांत हँसी की तरह चमकती है।",
      "file": "c024.ogg",
      "durationSec": 8.352
    },
    {
      "index": 25,
      "text": "आपको इसका पीछा करने की जरूरत नहीं है. यह पहले से ही यहाँ है.",
      "file": "c025.ogg",
      "durationSec": 11.328
    },
    {
      "index": 26,
      "text": "एक लहर दूर तक पहुँचती है, आपके पैर की उंगलियों को ठंडा करती है, फिर पीछे हट जाती है।",
      "file": "c026.ogg",
      "durationSec": 13.8
    },
    {
      "index": 27,
      "text": "गर्म रेत आपके पैरों को पुनः स्वस्थ कर देती है।",
      "file": "c027.ogg",
      "durationSec": 7.272
    },
    {
      "index": 28,
      "text": "अपनी सांस को तरंगों के साथ चलने दें - धीमी गति से अंदर, अधिक देर तक बाहर।",
      "file": "c028.ogg",
      "durationSec": 12.576
    },
    {
      "index": 29,
      "text": "शांति ही खाड़ी है. आप इसके अंदर हैं.",
      "file": "c029.ogg",
      "durationSec": 8.184
    },
    {
      "index": 30,
      "text": "अपना ध्यान अपने कंधे के ब्लेड के बीच की गर्मी पर टिकाएं।",
      "file": "c030.ogg",
      "durationSec": 8.904
    },
    {
      "index": 31,
      "text": "और नाक की नोक पर ताजा नमक हवा पर.",
      "file": "c031.ogg",
      "durationSec": 6.552
    },
    {
      "index": 32,
      "text": "कोमल कल्पना के साथ चट्टान रेखा का पता लगाएं।",
      "file": "c032.ogg",
      "durationSec": 8.28
    },
    {
      "index": 33,
      "text": "पत्थर दिन-ब-दिन गर्म होता गया। सिलवटों में छाया ठंडी.",
      "file": "c033.ogg",
      "durationSec": 10.416
    },
    {
      "index": 34,
      "text": "पास में एक ज्वारीय तालाब एक छोटी सी स्पष्ट दुनिया रखता है।",
      "file": "c034.ogg",
      "durationSec": 9.072
    },
    {
      "index": 35,
      "text": "आपको झुकने की जरूरत नहीं है। यह जानना ही काफी है।",
      "file": "c035.ogg",
      "durationSec": 10.224
    },
    {
      "index": 36,
      "text": "एक और लहर. ठंडी एड़ियाँ. गरम रेत. नरम सांस.",
      "file": "c036.ogg",
      "durationSec": 13.608
    },
    {
      "index": 37,
      "text": "कोव वही सरल दयालुता प्रदान करता रहता है।",
      "file": "c037.ogg",
      "durationSec": 6.888
    },
    {
      "index": 38,
      "text": "जाने से पहले इसे एक बार और प्राप्त करें।",
      "file": "c038.ogg",
      "durationSec": 7.32
    },
    {
      "index": 39,
      "text": "अब थोड़ी देर के लिए अकेले सांसों पर आराम करें।",
      "file": "c039.ogg",
      "durationSec": 8.112
    },
    {
      "index": 40,
      "text": "धीरे-धीरे श्वास लें।",
      "file": "c040.ogg",
      "durationSec": 4.416
    },
    {
      "index": 41,
      "text": "धीरे-धीरे सांस छोड़ें।",
      "file": "c041.ogg",
      "durationSec": 4.896
    },
    {
      "index": 42,
      "text": "श्वास लें.",
      "file": "c042.ogg",
      "durationSec": 3.168
    },
    {
      "index": 43,
      "text": "साँस छोड़ें।",
      "file": "c043.ogg",
      "durationSec": 3.672
    },
    {
      "index": 44,
      "text": "जहां भी शरीर गर्म हो वहां गर्माहट महसूस करें।",
      "file": "c044.ogg",
      "durationSec": 7.8
    },
    {
      "index": 45,
      "text": "जहां भी हवा ठंडी हो वहां ठंडक महसूस करें।",
      "file": "c045.ogg",
      "durationSec": 7.944
    },
    {
      "index": 46,
      "text": "श्वास लें.",
      "file": "c046.ogg",
      "durationSec": 3.168
    },
    {
      "index": 47,
      "text": "साँस छोड़ें।",
      "file": "c047.ogg",
      "durationSec": 3.672
    },
    {
      "index": 48,
      "text": "कहीं भी नहीं जाना। ठीक करने के लिए कुछ भी नहीं.",
      "file": "c048.ogg",
      "durationSec": 9.0
    },
    {
      "index": 49,
      "text": "श्वास लें.",
      "file": "c049.ogg",
      "durationSec": 3.168
    },
    {
      "index": 50,
      "text": "साँस छोड़ें।",
      "file": "c050.ogg",
      "durationSec": 3.672
    },
    {
      "index": 51,
      "text": "कुछ शांत सांसों के लिए यहां आराम करें।",
      "file": "c051.ogg",
      "durationSec": 6.672
    },
    {
      "index": 52,
      "text": "जान लें कि आप इस जगह पर कभी भी लौट सकते हैं।",
      "file": "c052.ogg",
      "durationSec": 8.544
    },
    {
      "index": 53,
      "text": "जब आप तैयार हों तो सांस को गहरा करें।",
      "file": "c053.ogg",
      "durationSec": 6.984
    },
    {
      "index": 54,
      "text": "उँगलियाँ और पैर की उँगलियाँ हिलाएँ।",
      "file": "c054.ogg",
      "durationSec": 6.024
    },
    {
      "index": 55,
      "text": "अपनी आँखें धीरे से खोलें.",
      "file": "c055.ogg",
      "durationSec": 5.76
    },
    {
      "index": 56,
      "text": "इस शांति का थोड़ा हिस्सा अपने साथ रखें।",
      "file": "c056.ogg",
      "durationSec": 7.128
    }
  ]
}
