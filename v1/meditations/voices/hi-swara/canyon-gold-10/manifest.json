{
  "id": "canyon-gold-10",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 774,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "ऐसा आसन खोजें जो आपसे कुछ न पूछे।",
      "file": "c001.ogg",
      "durationSec": 7.608
    },
    {
      "index": 2,
      "text": "आपको जिस भी सहारे की आवश्यकता हो, उसके साथ बैठें या लेटें।",
      "file": "c002.ogg",
      "durationSec": 10.464
    },
    {
      "index": 3,
      "text": "अपने हाथों को खुला या मुलायम रहने दें।",
      "file": "c003.ogg",
      "durationSec": 6.336
    },
    {
      "index": 4,
      "text": "अपनी आँखों को बंद होने दें, या नरम नज़र रखें।",
      "file": "c004.ogg",
      "durationSec": 8.16
    },
    {
      "index": 5,
      "text": "उन स्थानों को महसूस करें जहां आपका शरीर जमीन से मिलता है।",
      "file": "c005.ogg",
      "durationSec": 9.648
    },
    {
      "index": 6,
      "text": "एड़ियाँ, बैठने की हड्डियाँ, सिर का पिछला भाग, या रीढ़ की हड्डी की लंबाई।",
      "file": "c006.ogg",
      "durationSec": 12.168
    },
    {
      "index": 7,
      "text": "अभी रुकने के लिए कुछ भी नहीं है.",
      "file": "c007.ogg",
      "durationSec": 5.544
    },
    {
      "index": 8,
      "text": "नाक से धीमी गति से सांस लें।",
      "file": "c008.ogg",
      "durationSec": 6.048
    },
    {
      "index": 9,
      "text": "आती हुई हवा की ठंडक को महसूस करें।",
      "file": "c009.ogg",
      "durationSec": 6.792
    },
    {
      "index": 10,
      "text": "और थोड़ी देर सांस छोड़ें.",
      "file": "c010.ogg",
      "durationSec": 5.208
    },
    {
      "index": 11,
      "text": "बाहर निकलती सांस की गर्माहट को महसूस करें।",
      "file": "c011.ogg",
      "durationSec": 7.776
    },
    {
      "index": 12,
      "text": "दोबारा। नरम श्वास.",
      "file": "c012.ogg",
      "durationSec": 6.744
    },
    {
      "index": 13,
      "text": "बिना जल्दबाजी के साँस छोड़ें।",
      "file": "c013.ogg",
      "durationSec": 5.808
    },
    {
      "index": 14,
      "text": "कंधों को थोड़ा सा गिरने दें।",
      "file": "c014.ogg",
      "durationSec": 5.184
    },
    {
      "index": 15,
      "text": "जबड़े को खुला रहने दो.",
      "file": "c015.ogg",
      "durationSec": 4.848
    },
    {
      "index": 16,
      "text": "पेट को नरम रहने दें.",
      "file": "c016.ogg",
      "durationSec": 4.656
    },
    {
      "index": 17,
      "text": "तीन शांत सांसों के साथ वैसे ही रहें जैसे वे हैं।",
      "file": "c017.ogg",
      "durationSec": 7.776
    },
    {
      "index": 18,
      "text": "श्वास लें. आना।",
      "file": "c018.ogg",
      "durationSec": 5.736
    },
    {
      "index": 19,
      "text": "साँस छोड़ें। निपटारा करना।",
      "file": "c019.ogg",
      "durationSec": 7.056
    },
    {
      "index": 20,
      "text": "यदि मन भटकता है, तो कृपया उस पर ध्यान दें, और इस सांस पर वापस आएँ।",
      "file": "c020.ogg",
      "durationSec": 12.12
    },
    {
      "index": 21,
      "text": "मुलायम सोने और गुलाब से रंगी एक विस्तृत घाटी की कल्पना करें।",
      "file": "c021.ogg",
      "durationSec": 10.224
    },
    {
      "index": 22,
      "text": "दोपहर हो चुकी है. प्रकाश उदार है.",
      "file": "c022.ogg",
      "durationSec": 7.848
    },
    {
      "index": 23,
      "text": "पत्थर से गर्मी निकलती है जो पूरे दिन सूरज को पकड़े रहती है।",
      "file": "c023.ogg",
      "durationSec": 9.624
    },
    {
      "index": 24,
      "text": "अपनी पिंडलियों और हाथों के पिछले हिस्से पर उस तेज गर्मी को महसूस करें।",
      "file": "c024.ogg",
      "durationSec": 10.8
    },
    {
      "index": 25,
      "text": "सूखी, ताज़ी हवा घाटी के तल से नीचे की ओर चलती है।",
      "file": "c025.ogg",
      "durationSec": 9.336
    },
    {
      "index": 26,
      "text": "यह गर्मी का आराम लिए बिना आपके चेहरे को ठंडक पहुंचाता है।",
      "file": "c026.ogg",
      "durationSec": 9.504
    },
    {
      "index": 27,
      "text": "आप शांत दीवारों के बीच रेतीले रास्ते पर चलते हैं।",
      "file": "c027.ogg",
      "durationSec": 8.064
    },
    {
      "index": 28,
      "text": "कदम फुसफुसाते हैं. गूँज कोमल, लगभग विनम्र होती है।",
      "file": "c028.ogg",
      "durationSec": 10.584
    },
    {
      "index": 29,
      "text": "धूप से पकी धरती, सेज और साफ धूल की गंध लें।",
      "file": "c029.ogg",
      "durationSec": 8.976
    },
    {
      "index": 30,
      "text": "अपनी हथेली को चिकने पत्थर पर रखें।",
      "file": "c030.ogg",
      "durationSec": 6.648
    },
    {
      "index": 31,
      "text": "वहाँ संग्रहीत दिन के उजाले को महसूस करें - स्थिर, धैर्यवान गर्मी।",
      "file": "c031.ogg",
      "durationSec": 10.608
    },
    {
      "index": 32,
      "text": "छाया का एक रिबन कुछ कदमों तक शीतलता प्रदान करता है।",
      "file": "c032.ogg",
      "durationSec": 8.28
    },
    {
      "index": 33,
      "text": "फिर सूरज फिर से, एक शॉल की तरह अपने कंधों पर गर्म करें।",
      "file": "c033.ogg",
      "durationSec": 9.696
    },
    {
      "index": 34,
      "text": "आप उस स्थान पर आएँ जहाँ घाटी खुलती है।",
      "file": "c034.ogg",
      "durationSec": 6.552
    },
    {
      "index": 35,
      "text": "एक सपाट चट्टान पर अभी भी सुनहरी गर्माहट लिए हुए बैठें।",
      "file": "c035.ogg",
      "durationSec": 9.192
    },
    {
      "index": 36,
      "text": "महसूस करें कि यह आपकी सीट और रीढ़ की हड्डी से ऊपर उठ रहा है।",
      "file": "c036.ogg",
      "durationSec": 10.32
    },
    {
      "index": 37,
      "text": "हर सांस में ऊंचाई की ताजी हवा को महसूस करें।",
      "file": "c037.ogg",
      "durationSec": 7.92
    },
    {
      "index": 38,
      "text": "बहुत ऊपर, एक बाज़ बिना जल्दबाजी के धीमी गति से चक्कर लगाता है।",
      "file": "c038.ogg",
      "durationSec": 10.512
    },
    {
      "index": 39,
      "text": "आप वह त्वरित गुणवत्ता उधार लेते हैं।",
      "file": "c039.ogg",
      "durationSec": 6.432
    },
    {
      "index": 40,
      "text": "लंबी सांस लें. शरीर भारी. मन दीवारों के बीच के आकाश की तरह व्यापक है।",
      "file": "c040.ogg",
      "durationSec": 14.616
    },
    {
      "index": 41,
      "text": "सूरज ढलते ही परछाई को दूर चट्टान पर चढ़ते हुए देखें।",
      "file": "c041.ogg",
      "durationSec": 9.48
    },
    {
      "index": 42,
      "text": "रंग गहराते हैं. गर्मी नरम हो जाती है लेकिन ख़त्म नहीं होती।",
      "file": "c042.ogg",
      "durationSec": 10.608
    },
    {
      "index": 43,
      "text": "हवा में अब ठंडी, शाम की ताज़ी महक आ रही है।",
      "file": "c043.ogg",
      "durationSec": 7.896
    },
    {
      "index": 44,
      "text": "एक पल के लिए अपनी बाहों को अपने चारों ओर लपेट लें।",
      "file": "c044.ogg",
      "durationSec": 8.28
    },
    {
      "index": 45,
      "text": "अपने ही शरीर की गर्मी. पत्थर की गरमाहट. पर्याप्त।",
      "file": "c045.ogg",
      "durationSec": 10.2
    },
    {
      "index": 46,
      "text": "ध्यान से लेटें और पहले शांत तारे को देखें।",
      "file": "c046.ogg",
      "durationSec": 7.392
    },
    {
      "index": 47,
      "text": "घाटी आपको वैसे ही पकड़ती है जैसे एक हाथ से पानी पकड़ता है - धीरे से, बिना गिराए।",
      "file": "c047.ogg",
      "durationSec": 13.704
    },
    {
      "index": 48,
      "text": "उस धारणीय भावना में आराम करो।",
      "file": "c048.ogg",
      "durationSec": 5.928
    },
    {
      "index": 49,
      "text": "चट्टान से ठंडी हवा में उठने वाली आखिरी गर्मी पर ध्यान दें।",
      "file": "c049.ogg",
      "durationSec": 9.264
    },
    {
      "index": 50,
      "text": "ध्यान दें कि अब हवा में शाम, धूल और सेज की गंध आ रही है।",
      "file": "c050.ogg",
      "durationSec": 9.504
    },
    {
      "index": 51,
      "text": "आपकी सांसें व्यापक शांति से मेल खाने के लिए धीमी हो गई हैं।",
      "file": "c051.ogg",
      "durationSec": 9.816
    },
    {
      "index": 52,
      "text": "यदि भौंहों में तनाव रहता हो तो उसे इस सुनहरी रोशनी में नरम कर लें।",
      "file": "c052.ogg",
      "durationSec": 9.6
    },
    {
      "index": 53,
      "text": "यदि जबड़ा तंग है, तो उसे बाज की आसान चाल के रूप में ढीला छोड़ दें।",
      "file": "c053.ogg",
      "durationSec": 11.376
    },
    {
      "index": 54,
      "text": "गर्म पत्थर और ताजी हवा के कुछ और चक्रों तक रुकें।",
      "file": "c054.ogg",
      "durationSec": 8.544
    },
    {
      "index": 55,
      "text": "तुम लेट नहीं हो। आप यहां हैं।",
      "file": "c055.ogg",
      "durationSec": 7.056
    },
    {
      "index": 56,
      "text": "घाटी की दीवारों के बीच गर्म रेत पर कुछ और कदम चलें।",
      "file": "c056.ogg",
      "durationSec": 8.904
    },
    {
      "index": 57,
      "text": "आपकी छाया लंबी और निश्चिन्त होकर खिंचती है।",
      "file": "c057.ogg",
      "durationSec": 7.536
    },
    {
      "index": 58,
      "text": "दोनों हथेलियों को पुनः पत्थर पर रखें।",
      "file": "c058.ogg",
      "durationSec": 6.744
    },
    {
      "index": 59,
      "text": "गर्मी हाथों में वरदान बनकर आती है, तुम्हें कमाना नहीं पड़ता।",
      "file": "c059.ogg",
      "durationSec": 9.432
    },
    {
      "index": 60,
      "text": "हवा आपके बालों में ठंडक पहुँचाती है।",
      "file": "c060.ogg",
      "durationSec": 6.576
    },
    {
      "index": 61,
      "text": "ऋषि गंध. धूल की गंध. सूर्य की सुगंध.",
      "file": "c061.ogg",
      "durationSec": 10.512
    },
    {
      "index": 62,
      "text": "बैठना। घुटने मुलायम. रीढ़ की हड्डी आसान.",
      "file": "c062.ogg",
      "durationSec": 11.328
    },
    {
      "index": 63,
      "text": "रंग को सोने से गुलाब की ओर गहरा होते हुए देखें।",
      "file": "c063.ogg",
      "durationSec": 8.568
    },
    {
      "index": 64,
      "text": "गर्मी नरम हो जाती है. ताजगी बढ़ती है. संतुलन बना रहता है.",
      "file": "c064.ogg",
      "durationSec": 12.48
    },
    {
      "index": 65,
      "text": "इस तरह शामें तंत्रिका तंत्र को डाउनशिफ्ट करना सिखाती हैं।",
      "file": "c065.ogg",
      "durationSec": 8.712
    },
    {
      "index": 66,
      "text": "बिना प्रयास के पाठ उधार लें.",
      "file": "c066.ogg",
      "durationSec": 5.448
    },
    {
      "index": 67,
      "text": "पत्थर के लिए तीन साँसें।",
      "file": "c067.ogg",
      "durationSec": 5.136
    },
    {
      "index": 68,
      "text": "आकाश के लिए तीन.",
      "file": "c068.ogg",
      "durationSec": 4.224
    },
    {
      "index": 69,
      "text": "अपने शरीर के शांत प्राणी के लिए तीन, आराम कर रहे हैं।",
      "file": "c069.ogg",
      "durationSec": 8.76
    },
    {
      "index": 70,
      "text": "अब कहानी को विराम दीजिए और सनसनी पर कायम रहिए।",
      "file": "c070.ogg",
      "durationSec": 8.16
    },
    {
      "index": 71,
      "text": "इस जगह की ताजगी का आनंद लें।",
      "file": "c071.ogg",
      "durationSec": 5.76
    },
    {
      "index": 72,
      "text": "इसकी गर्माहट और शांति में सांस छोड़ें।",
      "file": "c072.ogg",
      "durationSec": 6.648
    },
    {
      "index": 73,
      "text": "श्वास लें.",
      "file": "c073.ogg",
      "durationSec": 3.168
    },
    {
      "index": 74,
      "text": "साँस छोड़ें।",
      "file": "c074.ogg",
      "durationSec": 3.672
    },
    {
      "index": 75,
      "text": "दोबारा। नरम श्वास.",
      "file": "c075.ogg",
      "durationSec": 6.744
    },
    {
      "index": 76,
      "text": "लंबी सांस छोड़ें.",
      "file": "c076.ogg",
      "durationSec": 4.248
    },
    {
      "index": 77,
      "text": "इस कल्पित संसार की ज़मीन से चिपके हुए शरीर को महसूस करें।",
      "file": "c077.ogg",
      "durationSec": 9.6
    },
    {
      "index": 78,
      "text": "श्वास लें.",
      "file": "c078.ogg",
      "durationSec": 3.168
    },
    {
      "index": 79,
      "text": "साँस छोड़ें।",
      "file": "c079.ogg",
      "durationSec": 3.672
    },
    {
      "index": 80,
      "text": "यदि विचार भटकते हैं, तो त्वचा पर गर्माहट लौटाएँ।",
      "file": "c080.ogg",
      "durationSec": 8.784
    },
    {
      "index": 81,
      "text": "या नाक पर हवा को ठंडा करने के लिए.",
      "file": "c081.ogg",
      "durationSec": 6.336
    },
    {
      "index": 82,
      "text": "श्वास लें.",
      "file": "c082.ogg",
      "durationSec": 3.168
    },
    {
      "index": 83,
      "text": "साँस छोड़ें।",
      "file": "c083.ogg",
      "durationSec": 3.672
    },
    {
      "index": 84,
      "text": "श्वास लें.",
      "file": "c084.ogg",
      "durationSec": 3.168
    },
    {
      "index": 85,
      "text": "साँस छोड़ें।",
      "file": "c085.ogg",
      "durationSec": 3.672
    },
    {
      "index": 86,
      "text": "रहना। नरम करना. जारी रखना।",
      "file": "c086.ogg",
      "durationSec": 9.24
    },
    {
      "index": 87,
      "text": "श्वास लें.",
      "file": "c087.ogg",
      "durationSec": 3.168
    },
    {
      "index": 88,
      "text": "साँस छोड़ें।",
      "file": "c088.ogg",
      "durationSec": 3.672
    },
    {
      "index": 89,
      "text": "एक और आसान चक्र.",
      "file": "c089.ogg",
      "durationSec": 4.488
    },
    {
      "index": 90,
      "text": "श्वास लें.",
      "file": "c090.ogg",
      "durationSec": 3.168
    },
    {
      "index": 91,
      "text": "साँस छोड़ें।",
      "file": "c091.ogg",
      "durationSec": 3.672
    },
    {
      "index": 92,
      "text": "कुछ और सांसों के लिए इस भावना में बने रहें।",
      "file": "c092.ogg",
      "durationSec": 6.768
    },
    {
      "index": 93,
      "text": "गर्मी। कोमलता. पर्याप्तता.",
      "file": "c093.ogg",
      "durationSec": 8.88
    },
    {
      "index": 94,
      "text": "जब भी आपको आवश्यकता हो आप इस स्थान पर वापस आ सकते हैं।",
      "file": "c094.ogg",
      "durationSec": 9.216
    },
    {
      "index": 95,
      "text": "यह केवल कल्पना में नहीं बल्कि आपके ध्यान में रहता है।",
