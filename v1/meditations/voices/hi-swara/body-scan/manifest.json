{
  "id": "body-scan",
  "voiceId": "hi-swara",
  "edgeVoice": "hi-IN-SwaraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 189,
  "chunks": [
    {
      "index": 0,
      "text": "हम धीरे से शरीर का स्कैन करेंगे.",
      "file": "c000.ogg",
      "durationSec": 6.024
    },
    {
      "index": 1,
      "text": "आराम से लेटें या बैठें।",
      "file": "c001.ogg",
      "durationSec": 5.04
    },
    {
      "index": 2,
      "text": "अगर सुरक्षित महसूस हो तो अपनी आंखें बंद कर लें।",
      "file": "c002.ogg",
      "durationSec": 8.016
    },
    {
      "index": 3,
      "text": "सिर के शीर्ष से शुरू करें.",
      "file": "c003.ogg",
      "durationSec": 5.424
    },
    {
      "index": 4,
      "text": "वहां किसी भी अनुभूति पर ध्यान दें। गर्मी। शीतलता. कुछ भी नहीं।",
      "file": "c004.ogg",
      "durationSec": 15.408
    },
    {
      "index": 5,
      "text": "इसे बदलने की कोई जरूरत नहीं है. जरा गौर करें.",
      "file": "c005.ogg",
      "durationSec": 10.032
    },
    {
      "index": 6,
      "text": "धीरे से माथे और आंखों की ओर ले जाएं।",
      "file": "c006.ogg",
      "durationSec": 7.296
    },
    {
      "index": 7,
      "text": "आंखों के आसपास की छोटी मांसपेशियों को नरम होने दें।",
      "file": "c007.ogg",
      "durationSec": 8.472
    },
    {
      "index": 8,
      "text": "जबड़े को महसूस करो. यदि आप कर सकते हैं तो खोल दें।",
      "file": "c008.ogg",
      "durationSec": 10.776
    },
    {
      "index": 9,
      "text": "जीभ हल्का आराम कर रही है।",
      "file": "c009.ogg",
      "durationSec": 5.016
    },
    {
      "index": 10,
      "text": "कंधे. क्या उन्हें उठा लिया गया है? उन्हें थोड़ा गिरने दो।",
      "file": "c010.ogg",
      "durationSec": 11.352
    },
    {
      "index": 11,
      "text": "भुजाएँ भारी. हाथ खुले या मुलायम.",
      "file": "c011.ogg",
      "durationSec": 7.848
    },
    {
      "index": 12,
      "text": "साँस के साथ छाती का उठना और गिरना।",
      "file": "c012.ogg",
      "durationSec": 6.96
    },
    {
      "index": 13,
      "text": "पेट मुलायम. कोई जबरदस्ती नहीं.",
      "file": "c013.ogg",
      "durationSec": 8.04
    },
    {
      "index": 14,
      "text": "कूल्हे और श्रोणि आराम कर रहे हैं।",
      "file": "c014.ogg",
      "durationSec": 5.88
    },
    {
      "index": 15,
      "text": "जांघें. घुटने. निचले पैर.",
      "file": "c015.ogg",
      "durationSec": 9.048
    },
    {
      "index": 16,
      "text": "पैर। तलवे फर्श या चटाई को छूते हुए।",
      "file": "c016.ogg",
      "durationSec": 8.352
    },
    {
      "index": 17,
      "text": "अब पूरे शरीर को जागरूकता के एक क्षेत्र के रूप में महसूस करें।",
      "file": "c017.ogg",
      "durationSec": 9.648
    },
    {
      "index": 18,
      "text": "इसके माध्यम से सांस चल रही है।",
      "file": "c018.ogg",
      "durationSec": 5.712
    },
    {
      "index": 19,
      "text": "यदि कोई तनावपूर्ण स्थान दिखाई देता है, तो वहां एक दयालु साँस छोड़ें।",
      "file": "c019.ogg",
      "durationSec": 11.28
    },
    {
      "index": 20,
      "text": "तीन शांत सांसों के लिए रुकें।",
      "file": "c020.ogg",
      "durationSec": 5.4
    },
    {
      "index": 21,
      "text": "जब आप तैयार हों, तो उंगलियों और पैर की उंगलियों को हिलाएं।",
      "file": "c021.ogg",
      "durationSec": 9.672
    },
    {
      "index": 22,
      "text": "अपनी आँखें खोलें। धीरे से लौटें.",
      "file": "c022.ogg",
      "durationSec": 8.064
    }
  ]
}
