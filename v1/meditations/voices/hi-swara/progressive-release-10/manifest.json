      "text": "[विराम:21]",
      "file": "c014.ogg",
      "durationSec": 4.68
    },
    {
      "index": 15,
      "text": "पिंडलियों को कस लें.",
      "file": "c015.ogg",
      "durationSec": 4.176
    },
    {
      "index": 16,
      "text": "पकड़ना।",
      "file": "c016.ogg",
      "durationSec": 3.024
