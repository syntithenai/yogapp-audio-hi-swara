  "totalSec": 236,
  "chunks": [
    {
      "index": 0,
      "text": "स्वागत।",
      "file": "c000.ogg",
      "durationSec": 3.168
    },
    {
      "index": 1,
      "text": "आने के लिए समय निकालें.",
      "file": "c001.ogg",
      "durationSec": 4.752
    },
    {
      "index": 2,
      "text": "सहारा लेकर बैठें या लेटें।",
      "file": "c002.ogg",
      "durationSec": 5.52
    },
    {
      "index": 3,
      "text": "अगर सुरक्षित महसूस हो तो आंखें बंद कर लें।",
      "file": "c003.ogg",
      "durationSec": 7.272
    },
    {
      "index": 4,
      "text": "जमीन के साथ संपर्क महसूस करें.",
      "file": "c004.ogg",
      "durationSec": 6.384
    },
    {
      "index": 5,
      "text": "धीमी गति से सांस अंदर लें.",
      "file": "c005.ogg",
      "durationSec": 5.64
    },
    {
      "index": 6,
      "text": "लंबी सांस छोड़ें.",
      "file": "c006.ogg",
      "durationSec": 4.248
    },
    {
      "index": 7,
      "text": "[विराम:27]",
      "file": "c007.ogg",
      "durationSec": 4.776
    },
    {
      "index": 8,
      "text": "दोबारा।",
      "file": "c008.ogg",
      "durationSec": 3.048
    },
    {
      "index": 9,
      "text": "[विराम:27]",
      "file": "c009.ogg",
      "durationSec": 4.776
    },
    {
      "index": 10,
      "text": "कंधों को झुक जाने दो.",
      "file": "c010.ogg",
      "durationSec": 4.512
    },
    {
      "index": 11,
      "text": "पेट को नरम होने दें.",
      "file": "c011.ogg",
      "durationSec": 4.512
    },
    {
      "index": 12,
      "text": "[विराम:34]",
      "file": "c012.ogg",
      "durationSec": 4.8
    },
    {
      "index": 13,
      "text": "यहां क्षमा का अर्थ है अपनी ही बंद मुट्ठी को मुक्त करना।",
      "file": "c013.ogg",
      "durationSec": 8.376
    },
    {
      "index": 14,
      "text": "नुकसान का दिखावा न करने से कोई फर्क नहीं पड़ता।",
      "file": "c014.ogg",
      "durationSec": 7.872
    },
    {
      "index": 15,
      "text": "[विराम:34]",
      "file": "c015.ogg",
      "durationSec": 4.8
    },
    {
      "index": 16,
      "text": "किसी ऐसी छोटी चीज़ से शुरुआत करें जिसे आप अपने ख़िलाफ़ रखते हैं।",
      "file": "c016.ogg",
      "durationSec": 10.848
    },
    {
      "index": 17,
      "text": "एक गलती. एक कमी.",
      "file": "c017.ogg",
      "durationSec": 6.096
    },
    {
      "index": 18,
      "text": "[विराम:34]",
      "file": "c018.ogg",
      "durationSec": 4.8
    },
    {
      "index": 19,
      "text": "चुपचाप: मैं इंसान होने के लिए खुद को माफ करता हूं।",
      "file": "c019.ogg",
      "durationSec": 9.36
    },
    {
      "index": 20,
      "text": "मैं वह चीज़ जारी करता हूँ जिसे अब मुझे ले जाने की आवश्यकता नहीं है।",
      "file": "c020.ogg",
      "durationSec": 10.656
    },
    {
      "index": 21,
      "text": "[विराम:54]",
      "file": "c021.ogg",
      "durationSec": 4.128
    },
    {
      "index": 22,
      "text": "यदि यह सही लगता है, तो दूसरे के साथ हुई हल्की कठिनाई को ध्यान में रखें।",
      "file": "c022.ogg",
      "durationSec": 11.448
    },
    {
      "index": 23,
      "text": "सबसे कठिन कहानी नहीं. एक हल्का वाला.",
      "file": "c023.ogg",
      "durationSec": 8.688
    },
    {
      "index": 24,
      "text": "[विराम:34]",
      "file": "c024.ogg",
      "durationSec": 4.8
    },
    {
      "index": 25,
      "text": "मैं जो कर सकता हूं उसे जारी करता हूं।",
      "file": "c025.ogg",
      "durationSec": 7.152
    },
    {
      "index": 26,
      "text": "मैं अपनी सीमाएं रखता हूं. मैंने अतिरिक्त वजन कम किया.",
      "file": "c026.ogg",
      "durationSec": 10.944
    },
    {
      "index": 27,
      "text": "[विराम:54]",
      "file": "c027.ogg",
      "durationSec": 4.128
    },
    {
      "index": 28,
      "text": "जिन स्थानों पर जकड़न है वहां सांस लें।",
      "file": "c028.ogg",
      "durationSec": 6.768
    },
    {
      "index": 29,
      "text": "[विराम:68]",
      "file": "c029.ogg",
      "durationSec": 4.368
    },
    {
      "index": 30,
      "text": "उस स्थान पर आराम करें जो मुट्ठी नरम होने पर खुलता है।",
      "file": "c030.ogg",
      "durationSec": 8.592
    },
    {
      "index": 31,
      "text": "[विराम:81]",
      "file": "c031.ogg",
      "durationSec": 4.512
    },
    {
      "index": 32,
      "text": "[विराम:41]",
      "file": "c032.ogg",
      "durationSec": 4.8
    },
    {
      "index": 33,
      "text": "श्वास को गहरा करना शुरू करें।",
      "file": "c033.ogg",
      "durationSec": 5.592
    },
    {
      "index": 34,
      "text": "कमरे को फिर से महसूस करो.",
      "file": "c034.ogg",
      "durationSec": 5.352
    },
    {
      "index": 35,
      "text": "उँगलियाँ और पैर की उँगलियाँ हिलाएँ।",
      "file": "c035.ogg",
      "durationSec": 6.024
    },
    {
      "index": 36,
      "text": "तैयार होने पर आँखें खोलें।",
      "file": "c036.ogg",
      "durationSec": 5.256
    },
    {
      "index": 37,
      "text": "आगे जो आता है उसमें धीरे-धीरे आगे बढ़ें।",
      "file": "c037.ogg",
      "durationSec": 7.296
    }
  ]
}
