      "durationSec": 5.088
    },
    {
      "index": 7,
      "text": "[विराम:19]",
      "file": "c007.ogg",
      "durationSec": 4.296
    },
    {
      "index": 8,
      "text": "ध्यान दोनों पैरों पर लाएँ।",
      "file": "c008.ogg",
      "durationSec": 5.04
    },
    {
      "index": 9,
      "text": "पंजों को मोड़ें और पैरों को कस लें।",
      "file": "c009.ogg",
      "durationSec": 6.384
    },
    {
      "index": 10,
      "text": "पकड़ना।",
